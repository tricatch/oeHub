<configuration>

    <!-- -Doe.log.dir, or <oe.home>/log by default (see LogDirDefiner) -->
    <define name="LOG_DIR" class="tricatch.oe.hub.config.LogDirDefiner"/>
    <!-- TRACE with -Doe.dev=true or -Doe.log.console=true, OFF otherwise (see ConsoleLevelDefiner) -->
    <define name="CONSOLE_LEVEL" class="tricatch.oe.hub.config.ConsoleLevelDefiner"/>

    <!-- Off by default: the threshold drops every event unless -Doe.dev or -Doe.log.console is true -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LEVEL}</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Today's log is oehub.log; at midnight it rolls to oehub.<date>.log, and rolled files
         older than 30 days are deleted (also checked at startup, so a long-stopped instance
         doesn't keep stale files). -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/oehub.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/oehub.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Reduce noise from verbose libraries -->
    <logger name="io.netty" level="INFO"/>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.mybatis" level="INFO"/>
    <logger name="com.h2database" level="INFO"/>
    <!-- Especially chatty during CONNECT tunneling: every relayed chunk logs a
         Reading/Retaining/Writing/Wrote line per direction. -->
    <logger name="org.littleshoot.proxy" level="INFO"/>

</configuration>
