{% extends "templates/app-layout.pebble" %}

{% block title %}{{ msg['my.info.title'] }} — oeHub{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/css/oe-panel.css">
<link rel="stylesheet" href="/css/info-page.css">
{% endblock %}

{% block content %}
<div class="settings-app" id="myInfoApp">
<script>
  (function() {
    if (localStorage.getItem('oeWidthExpanded') === 'true') {
      document.getElementById('myInfoApp').classList.add('expanded');
      document.body.classList.add('oe-expanded');
    }
  })();
</script>

  <div class="info-page-main">
    <h5>{{ msg['my.info.title'] }}</h5>

    <div class="oe-info-section">
      <table class="oe-info-table">
        <colgroup><col style="width:140px;"><col></colgroup>
        <thead><tr><th colspan="2">{{ msg['my.info.section.account'] }}</th></tr></thead>
        <tbody>
          <tr><td class="oe-info-label">ID</td><td>{{ user.userId }}</td></tr>
          <tr><td class="oe-info-label">OID</td><td>{{ user.oid }} <span class="text-muted">({{ msg['my.info.oid.desc'] }})</span></td></tr>
          <tr><td class="oe-info-label">{{ msg['users.col.created'] }}</td><td>{{ createAt }}</td></tr>
          <tr><td class="oe-info-label">{{ msg['users.col.last.login'] }}</td><td>{{ lastLoginAt }}</td></tr>
        </tbody>
      </table>
    </div>

    {# ── API Tokens ── #}
    <div class="oe-info-section">
      <table class="oe-info-table mb-0">
        <colgroup>
          <col>
          <col style="width:140px;">
          <col style="width:140px;">
          <col style="width:140px;">
          <col style="width:50px;">
        </colgroup>
        <thead>
          <tr>
            <th colspan="5">
              <div class="d-flex align-items-center justify-content-between">
                <span>{{ msg['my.info.section.api.tokens'] }}</span>
                <button type="button" class="oe-tbl-btn oe-tbl-btn-action" id="btnCreateApiToken" title="{{ msg['my.info.api.tokens.add'] }}">
                  <span class="oe-icon oe-icon-new" style="width:15px;height:15px"></span>
                </button>
              </div>
            </th>
          </tr>
          <tr class="oe-subhead">
            <th>{{ msg['my.info.api.tokens.col.name'] }}</th>
            <th>{{ msg['my.info.api.tokens.col.created'] }}</th>
            <th>{{ msg['my.info.api.tokens.col.last.used'] }}</th>
            <th>{{ msg['my.info.api.tokens.col.expires'] }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="apiTokenTbody">
          <tr><td colspan="5" class="text-muted text-center py-3">{{ msg['my.info.api.tokens.empty'] }}</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Create API token -->
<div class="modal fade" id="apiTokenCreateModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header">
        <h5 class="modal-title">{{ msg['my.info.api.tokens.add'] }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">{{ msg['my.info.api.tokens.col.name'] }}</label>
          <input type="text" class="form-control" id="apiTokenNameInput" maxlength="128" placeholder="{{ msg['my.info.api.tokens.name.placeholder'] }}">
        </div>
        <div class="mb-1">
          <label class="form-label">{{ msg['my.info.api.tokens.expiry.label'] }}</label>
          <select class="form-select" id="apiTokenExpirySelect">
            <option value="">{{ msg['my.info.api.tokens.expiry.never'] }}</option>
            <option value="30">{{ msg['my.info.api.tokens.expiry.30'] }}</option>
            <option value="90">{{ msg['my.info.api.tokens.expiry.90'] }}</option>
            <option value="365">{{ msg['my.info.api.tokens.expiry.365'] }}</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="oe-modal-btn oe-modal-btn-plain" data-bs-dismiss="modal">{{ msg['btn.cancel'] }}</button>
        <button type="button" class="oe-modal-btn oe-modal-btn-primary" id="btnSubmitApiTokenCreate">{{ msg['my.info.api.tokens.add'] }}</button>
      </div>
    </div>
  </div>
</div>

<!-- API token reveal (shown once right after creation) -->
<div class="modal fade" id="apiTokenRevealModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header">
        <h5 class="modal-title">{{ msg['my.info.api.tokens.reveal.title'] }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-2">{{ msg['my.info.api.tokens.reveal.desc'] }}</p>
        <div class="input-group">
          <input type="text" class="form-control setup-mono" id="apiTokenRevealValue" readonly>
          <button type="button" class="btn btn-sm btn-oe-secondary" id="btnCopyApiToken" title="{{ msg['ui.copy.clipboard'] }}">
            <span class="oe-icon oe-icon-copy" style="width:13px;height:13px"></span>
          </button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="oe-modal-btn oe-modal-btn-plain" data-bs-dismiss="modal">{{ msg['btn.close'] }}</button>
      </div>
    </div>
  </div>
</div>

<script>initWidthToggle(document.getElementById('myInfoApp'), document.getElementById('btnToggleWidth'));</script>
<script>
  function loadApiTokens() {
    fetch('/api/user/api-tokens')
      .then(function (r) { return r.json(); })
      .then(renderApiTokens)
      .catch(function () {});
  }

  function renderApiTokens(tokens) {
    var tbody = document.getElementById('apiTokenTbody');
    if (!tokens || tokens.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-muted text-center py-3">' + escHtml(MSG['my.info.api.tokens.empty']) + '</td></tr>';
      return;
    }
    tbody.innerHTML = tokens.map(function (t) {
      return '<tr data-token-id="' + escHtml(t.tokenId) + '">' +
        '<td>' + escHtml(t.tokenName) + '</td>' +
        '<td class="small text-muted">' + escHtml(t.createAt) + '</td>' +
        '<td class="small text-muted">' + escHtml(t.lastUsedAt || MSG['my.info.api.tokens.never.used']) + '</td>' +
        '<td class="small text-muted">' + escHtml(t.expiresAt || MSG['my.info.api.tokens.never.expires']) + '</td>' +
        '<td class="text-end"><button class="oe-tbl-btn oe-tbl-btn-delete btn-revoke-api-token" title="' + escHtml(MSG['tooltip.revoke.api.token']) + '">' +
        '<span class="oe-icon oe-icon-delete" style="width:13px;height:13px"></span></button></td></tr>';
    }).join('');
    tbody.querySelectorAll('.btn-revoke-api-token').forEach(function (btn) {
      btn.addEventListener('click', onRevokeApiToken);
    });
  }

  function onRevokeApiToken() {
    var row = this.closest('tr');
    var tokenId = row.dataset.tokenId;
    if (!confirm(MSG['confirm.revoke.api.token'])) return;
    fetch('/api/user/api-tokens/' + tokenId, { method: 'DELETE' })
      .then(function (r) {
        if (r.ok) { loadApiTokens(); return; }
        showToast(MSG['toast.api.token.revoke.failed']);
      }).catch(function () { showToast(MSG['toast.api.token.revoke.failed']); });
  }

  var btnCreateApiToken = document.getElementById('btnCreateApiToken');
  btnCreateApiToken.addEventListener('click', function () {
    document.getElementById('apiTokenNameInput').value = '';
    document.getElementById('apiTokenExpirySelect').value = '';
    new bootstrap.Modal(document.getElementById('apiTokenCreateModal')).show();
  });

  document.getElementById('btnSubmitApiTokenCreate').addEventListener('click', function () {
    var btn = this;
    var name = document.getElementById('apiTokenNameInput').value.trim();
    if (!name) { showToast(MSG['toast.api.token.name.required']); return; }
    var expirySelect = document.getElementById('apiTokenExpirySelect').value;
    var expiresInDays = expirySelect ? Number(expirySelect) : null;

    btn.disabled = true;
    fetch('/api/user/api-tokens', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tokenName: name, expiresInDays: expiresInDays })
    })
      .then(function (r) {
        btn.disabled = false;
        if (!r.ok) { showToast(MSG['toast.api.token.create.failed']); return null; }
        return r.json();
      })
      .then(function (data) {
        if (!data) return;
        bootstrap.Modal.getInstance(document.getElementById('apiTokenCreateModal')).hide();
        document.getElementById('apiTokenRevealValue').value = data.token;
        new bootstrap.Modal(document.getElementById('apiTokenRevealModal')).show();
        loadApiTokens();
      })
      .catch(function () {
        btn.disabled = false;
        showToast(MSG['toast.api.token.create.failed']);
      });
  });

  document.getElementById('btnCopyApiToken').addEventListener('click', function () {
    copyToClipboard(document.getElementById('apiTokenRevealValue').value).then(function () {
      showToast(MSG['toast.api.token.copied']);
    });
  });

  loadApiTokens();
</script>
{% endblock %}
