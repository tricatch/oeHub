{% extends "templates/app-layout.pebble" %}

{% block title %}{{ msg['users.title'] }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/css/settings.css">
<link rel="stylesheet" href="/css/oe-panel.css">
<link rel="stylesheet" href="/css/info-page.css">
<style>
  .oe-role-icon { width: 16px; height: 16px; }
  .oe-role-icon-user  { color: #adb5bd; }
  .oe-role-icon-admin { color: #5a9e2f; }
  .users-search-wrap { position: relative; width: 200px; }
  .users-search-wrap .oe-icon-search {
    position: absolute;
    left: 0.65rem;
    top: 50%;
    transform: translateY(-50%);
    width: 14px; height: 14px;
    opacity: 0.4;
    pointer-events: none;
  }
  .users-search-wrap input { padding-left: 2rem; font-size: 0.74rem; }
  .oe-subhead th { background: #fff; color: #6c757d; }
  tr.oe-removing { opacity: 0; transition: opacity 0.25s ease; }
  th[data-sort] { cursor: pointer; user-select: none; white-space: nowrap; }
  th[data-sort]:hover { color: #5a8a28; }
  .sort-icon { font-size: 0.68rem; margin-left: 0.2rem; opacity: 0.35; }
  th[data-sort].sort-asc .sort-icon,
  th[data-sort].sort-desc .sort-icon { opacity: 1; color: #5a9e2f; }
  .team-name-text { cursor: text; border-radius: 4px; padding: 0.05rem 0.3rem; }
  .team-name-text.editing { outline: 1px solid #a8d878; background: #fff; }
</style>
{% endblock %}

{% block content %}
<div class="settings-app" id="usersApp">
<script>(function(){if(localStorage.getItem('oeWidthExpanded')==='true'){document.getElementById('usersApp').classList.add('expanded');document.body.classList.add('oe-expanded');}})();</script>

<div class="settings-main">

  <div class="d-flex align-items-center justify-content-between mb-3">
    <h5 class="mb-0">{{ msg['users.title'] }}</h5>
    {% if workspaceMode %}
    <button type="button" class="btn btn-sm btn-oe-secondary" id="btnRotateWsKey" title="{{ msg['tooltip.rotate.ws.key'] }}">{{ msg['users.rotate.ws.key'] }}</button>
    {% endif %}
  </div>

  {% if workspaceMode %}
  <div class="oe-info-section">
    <table class="oe-info-table mb-0">
      <colgroup>
        <col style="width:130px;">
        <col>
        <col style="width:175px;">
        <col style="width:90px;">
      </colgroup>
      <thead>
        <tr>
          <th colspan="4">
            <div class="d-flex align-items-center justify-content-between">
              <span>{{ msg['users.invite.title'] }}</span>
              <div class="d-flex align-items-center gap-2">
                <select id="inviteTeamSelect" class="form-select form-select-sm" style="width:150px;" hidden></select>
                <button type="button" class="oe-tbl-btn oe-tbl-btn-action" id="btnCreateInvite" title="{{ msg['users.invite.btn.create'] }}">
                  <span class="oe-icon oe-icon-new" style="width:15px;height:15px"></span>
                </button>
              </div>
            </div>
          </th>
        </tr>
        <tr class="oe-subhead">
          <th>{{ msg['users.invite.col.team'] }}</th>
          <th>{{ msg['users.invite.col.code'] }}</th>
          <th>{{ msg['users.invite.col.expires'] }}</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="invitesTbody">
        <tr><td colspan="4" class="text-muted text-center py-3">{{ msg['users.invite.empty'] }}</td></tr>
      </tbody>
    </table>
  </div>

  <div class="oe-info-section" id="teamsSection">
    <table class="oe-info-table mb-0">
      <colgroup>
        <col>
        <col style="width:90px;">
      </colgroup>
      <thead>
        <tr>
          <th colspan="2">
            <div class="d-flex align-items-center justify-content-between">
              <span>{{ msg['teams.title'] }}</span>
              <div class="d-flex align-items-center gap-2">
                <input type="text" id="newTeamName" class="form-control form-control-sm" style="width:170px;" placeholder="{{ msg['teams.placeholder.name'] }}">
                <button type="button" class="oe-tbl-btn oe-tbl-btn-action" id="btnCreateTeam" title="{{ msg['tooltip.new.team'] }}">
                  <span class="oe-icon oe-icon-new" style="width:15px;height:15px"></span>
                </button>
              </div>
            </div>
          </th>
        </tr>
      </thead>
      <tbody id="teamsTbody">
        <tr><td colspan="2" class="text-muted text-center py-3">{{ msg['teams.empty'] }}</td></tr>
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="oe-info-section" id="pendingSection" hidden>
    <table class="oe-info-table mb-0">
      <colgroup>
        <col>
        <col style="width:150px;">
        <col style="width:175px;">
      </colgroup>
      <thead>
        <tr>
          <th colspan="3">
            <span>{{ msg['users.pending.title'] }}</span>
          </th>
        </tr>
        <tr class="oe-subhead">
          <th>{{ msg['users.pending.col.userid'] }}</th>
          <th>{{ msg['users.pending.col.requested'] }}</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="pendingTbody">
      </tbody>
    </table>
  </div>

  <div class="oe-info-section">
    <table class="oe-info-table mb-0">
      <colgroup>
        <col>
        <col style="width:90px;">
        {% if workspaceMode %}<col style="width:140px;">{% endif %}
        <col style="width:150px;">
        <col style="width:150px;">
        <col style="width:155px;">
        <col style="width:175px;">
      </colgroup>
      <thead>
        <tr>
          <th colspan="{{ workspaceMode ? 7 : 6 }}">
            <div class="d-flex align-items-center justify-content-between">
              <span>{{ msg['users.card.header'] }}</span>
              <div class="users-search-wrap mb-0">
                <span class="oe-icon oe-icon-search"></span>
                <input type="search" id="userSearch" class="form-control form-control-sm"
                       placeholder="{{ msg['users.search.placeholder'] }}">
              </div>
            </div>
          </th>
        </tr>
        <tr class="oe-subhead">
          <th>{{ msg['users.col.userid'] }}</th>
          <th class="text-center" data-sort="role">{{ msg['users.col.role'] }}<span class="sort-icon">↕</span></th>
          {% if workspaceMode %}<th>{{ msg['users.col.team'] }}</th>{% endif %}
          <th>{{ msg['users.col.created'] }}</th>
          <th>{{ msg['users.col.updated'] }}</th>
          <th class="text-center" data-sort="lastLoginAt">{{ msg['users.col.last.login'] }}<span class="sort-icon">↕</span></th>
          <th></th>
        </tr>
      </thead>
      <tbody id="usersTbody">
        <tr><td colspan="{{ workspaceMode ? 7 : 6 }}" class="text-muted text-center py-3">{{ msg['users.empty'] }}</td></tr>
      </tbody>
    </table>

  </div>

</div>

</div><!-- /settings-app -->

<!-- Password reset result modal -->
<div class="modal fade" id="pwResetModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header">
        <h5 class="modal-title">{{ msg['modal.password.reset.title'] }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-2">{{ msg['users.password.reset.desc'] }}</p>
        <div class="input-group">
          <input type="text" class="form-control" id="pwResetValue" readonly>
          <button type="button" class="btn btn-sm btn-oe-secondary" id="btnCopyResetPw" title="{{ msg['ui.copy.clipboard'] }}">
            <span class="oe-icon oe-icon-copy" style="width:13px;height:13px"></span>
          </button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="oe-modal-btn oe-modal-btn-plain" data-bs-dismiss="modal">{{ msg['btn.close'] }}</button>
      </div>
    </div>
  </div>
</div>

<!-- Workspace-key rotation progress modal - non-dismissable, both the delete-member and manual
     rotation entry points share it (e2eEncryption design doc §7.1). Deliberately not "fade": a
     rotation can finish (and call hide()) while the fade-in transition from show() is still
     running, and Bootstrap's Modal.hide() silently no-ops while _isTransitioning is true - no
     animation means no transition window, so hide() always takes effect. -->
<div class="modal" id="rotationProgressModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header">
        <h5 class="modal-title">{{ msg['rotation.progress.title'] }}</h5>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-2">{{ msg['rotation.progress.text'] }}</p>
        <div class="progress" style="height: 8px;">
          <div class="progress-bar oe-progress-bar-brand" id="rotationProgressBar" role="progressbar" style="width: 0%"></div>
        </div>
        <div class="small text-muted text-end mt-1"><span id="rotationProgressCount"></span></div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var currentUserId = '{{ user.userId | escape }}';
  // The "admin" role this screen grants/revokes: 'ws_adm' in workspace mode (this screen is
  // workspace-scoped and must never grant the instance-wide 'adm'), 'adm' in standalone
  // (unchanged - no separate ws_adm role in practice there). See AdminUserController.apiSetRole.
  var ADMIN_ROLE = '{{ workspaceMode ? "ws_adm" : "adm" }}';
  var searchTimer;
  var currentUsers = [];
  var currentTeams = [];
  var sortCol = null;
  var sortDir = 1;

  document.querySelectorAll('th[data-sort]').forEach(function(th) {
    th.addEventListener('click', function() { sortAndRender(this.dataset.sort); });
  });

  document.getElementById('userSearch').addEventListener('input', function () {
    clearTimeout(searchTimer);
    var q = this.value;
    searchTimer = setTimeout(function () { loadUsers(q); }, 300);
  });

  function loadUsers(q) {
    var url = '/api/admin/users' + (q.trim() ? '?q=' + encodeURIComponent(q.trim()) : '');
    fetch(url)
      .then(function (r) { return r.json(); })
      .then(function (users) {
        currentUsers = users;
        if (sortCol) sortCurrentUsers();
        renderUsers(currentUsers);
      })
      .catch(function () { showToast(MSG['toast.role.update.failed']); });
  }

  function sortAndRender(col) {
    sortDir = sortCol === col ? -sortDir : 1;
    sortCol = col;
    sortCurrentUsers();
    updateSortHeaders();
    renderUsers(currentUsers);
  }

  function sortCurrentUsers() {
    currentUsers.sort(function(a, b) {
      var av = a[sortCol] || '';
      var bv = b[sortCol] || '';
      if (sortCol === 'role') {
        av = av === ADMIN_ROLE ? 0 : 1;
        bv = bv === ADMIN_ROLE ? 0 : 1;
        return (av - bv) * sortDir;
      }
      if (!av && bv) return 1;
      if (av && !bv) return -1;
      return av < bv ? -sortDir : av > bv ? sortDir : 0;
    });
  }

  function updateSortHeaders() {
    document.querySelectorAll('th[data-sort]').forEach(function(th) {
      th.classList.remove('sort-asc', 'sort-desc');
      var icon = th.querySelector('.sort-icon');
      if (icon) icon.textContent = '↕';
      if (th.dataset.sort === sortCol) {
        th.classList.add(sortDir === 1 ? 'sort-asc' : 'sort-desc');
        if (icon) icon.textContent = sortDir === 1 ? '↑' : '↓';
      }
    });
  }

  function renderUsers(users) {
    var tbody = document.getElementById('usersTbody');
    var colspan = window.OE_WORKSPACE_MODE ? 7 : 6;
    if (users.length === 0) {
      tbody.innerHTML = '<tr><td colspan="' + colspan + '" class="text-muted text-center py-3">' + escHtml(MSG['users.empty']) + '</td></tr>';
      return;
    }
    tbody.innerHTML = users.map(function (u) {
      return '<tr data-user-no="' + u.userNo + '" data-role="' + u.role + '">' +
        '<td>' + escHtml(u.userId) + '</td>' +
        '<td class="text-center">' + roleIconHtml(u.role) + '</td>' +
        (window.OE_WORKSPACE_MODE ? '<td>' + teamSelectHtml(u) + '</td>' : '') +
        '<td class="small text-muted">' + escHtml(u.createAt) + '</td>' +
        '<td class="small text-muted">' + escHtml(u.updatedAt) + '</td>' +
        '<td class="small text-muted text-center">' + escHtml(u.lastLoginAt || '') + '</td>' +
        '<td class="text-end">' + actionHtml(u.userId, u.role) + '</td>' +
        '</tr>';
    }).join('');
    bindButtons();
  }

  // Team reassignment dropdown for one member row (cloudGroupService design doc §2.9) - "no team"
  // is always the first option, then every team in the workspace alphabetically (already sorted
  // server-side by TeamMapper.findByWsNo).
  function teamSelectHtml(u) {
    var options = '<option value=""' + (!u.teamNo ? ' selected' : '') + '>' + escHtml(MSG['teams.select.none']) + '</option>' +
      currentTeams.map(function (t) {
        return '<option value="' + t.teamNo + '"' + (String(u.teamNo) === String(t.teamNo) ? ' selected' : '') + '>' + escHtml(t.teamName) + '</option>';
      }).join('');
    return '<select class="form-select form-select-sm user-team-select">' + options + '</select>';
  }

  function roleIconHtml(role) {
    var isAdmin = role === ADMIN_ROLE;
    var cls = isAdmin ? 'oe-icon-admin oe-role-icon-admin' : 'oe-icon-user oe-role-icon-user';
    var title = isAdmin ? ' title="' + escHtml(MSG['users.role.admin']) + '"' : '';
    return '<span class="oe-icon ' + cls + ' oe-role-icon"' + title + '></span>';
  }

  function actionHtml(userId, role) {
    var isSelf  = userId === currentUserId;
    var isAdmin = role === ADMIN_ROLE;
    var roleIcon     = isAdmin ? 'oe-icon-revoke-admin' : 'oe-icon-grant-admin';
    var roleTitle    = isAdmin ? MSG['users.btn.revoke.admin'] : MSG['users.btn.grant.admin'];
    var roleDisabled = (isAdmin && isSelf) ? ' disabled' : '';
    var delDisabled  = isSelf ? ' disabled' : '';
    return '<button class="oe-tbl-btn oe-tbl-btn-action btn-toggle-role"' + roleDisabled +
      ' title="' + escHtml(roleTitle) + '">' +
      '<span class="oe-icon ' + roleIcon + '" style="width:15px;height:15px"></span></button>' +
      ' <button class="oe-tbl-btn oe-tbl-btn-action btn-reset-password ms-1"' +
      ' title="' + escHtml(MSG['users.btn.reset.password']) + '">' +
      '<span class="oe-icon oe-icon-reset-password" style="width:15px;height:15px"></span></button>' +
      ' <button class="oe-tbl-btn oe-tbl-btn-delete btn-delete-user ms-1"' + delDisabled +
      ' title="' + escHtml(MSG['tooltip.delete.user']) + '">' +
      '<span class="oe-icon oe-icon-delete" style="width:13px;height:13px"></span></button>';
  }

  function bindButtons() {
    document.querySelectorAll('.btn-toggle-role').forEach(function (btn) {
      btn.addEventListener('click', onToggle);
    });
    document.querySelectorAll('.btn-reset-password').forEach(function (btn) {
      btn.addEventListener('click', onResetPassword);
    });
    document.querySelectorAll('.btn-delete-user').forEach(function (btn) {
      btn.addEventListener('click', onDelete);
    });
    document.querySelectorAll('.user-team-select').forEach(function (sel) {
      sel.addEventListener('change', onChangeUserTeam);
    });
  }

  function bindRowButtons(row) {
    var toggle = row.querySelector('.btn-toggle-role');
    var reset  = row.querySelector('.btn-reset-password');
    var del    = row.querySelector('.btn-delete-user');
    var team   = row.querySelector('.user-team-select');
    if (toggle) toggle.addEventListener('click', onToggle);
    if (reset)  reset.addEventListener('click', onResetPassword);
    if (del)    del.addEventListener('click', onDelete);
    if (team)   team.addEventListener('change', onChangeUserTeam);
  }

  function onChangeUserTeam() {
    var sel = this;
    var row = sel.closest('tr');
    var userNo = row.dataset.userNo;
    var teamNo = sel.value ? Number(sel.value) : null;
    sel.disabled = true;
    fetch('/api/admin/users/' + userNo + '/team', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ teamNo: teamNo })
    }).then(function (r) {
      sel.disabled = false;
      if (r.ok) {
        showToast(MSG['toast.user.team.updated']);
        var u = currentUsers.find(function (u) { return String(u.userNo) === String(userNo); });
        if (u) u.teamNo = teamNo;
      } else {
        showToast(MSG['toast.user.team.update.failed']);
      }
    }).catch(function () {
      sel.disabled = false;
      showToast(MSG['toast.user.team.update.failed']);
    });
  }

  function onToggle() {
    var btn = this;
    var row = btn.closest('tr');
    var userNo = row.dataset.userNo;
    var newRole = row.dataset.role === ADMIN_ROLE ? 'usr' : ADMIN_ROLE;
    var confirmMsg = newRole === ADMIN_ROLE ? MSG['confirm.grant.admin'] : MSG['confirm.revoke.admin'];
    if (!confirm(confirmMsg)) return;
    btn.disabled = true;
    fetch('/api/admin/users/' + userNo + '/role', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ role: newRole })
    }).then(function (r) {
      if (r.ok) {
        showToast(MSG['toast.role.updated']);
        var u = currentUsers.find(function(u) { return String(u.userNo) === String(userNo); });
        if (u) u.role = newRole;
        applyRoleToRow(row, newRole);
      } else {
        btn.disabled = false;
        r.clone().json().then(function (data) {
          showToast(data && data.error === 'last_ws_admin' ? MSG['toast.last.ws.admin.blocked'] : MSG['toast.role.update.failed']);
        }).catch(function () {
          showToast(MSG['toast.role.update.failed']);
        });
      }
    }).catch(function () {
      btn.disabled = false;
      showToast(MSG['toast.role.update.failed']);
    });
  }

  function applyRoleToRow(row, newRole) {
    var userId = row.cells[0].textContent.trim();
    row.dataset.role = newRole;
    row.cells[1].innerHTML = roleIconHtml(newRole);
    row.cells[row.cells.length - 1].innerHTML = actionHtml(userId, newRole);
    bindRowButtons(row);
  }

  function onResetPassword() {
    var btn = this;
    var row = btn.closest('tr');
    var userNo = row.dataset.userNo;
    if (!confirm(MSG['confirm.reset.password'])) return;
    btn.disabled = true;
    fetch('/api/admin/users/' + userNo + '/reset-password', { method: 'POST' })
      .then(function (r) {
        btn.disabled = false;
        if (r.ok) {
          return r.json().then(function (data) {
            document.getElementById('pwResetValue').value = data.password;
            new bootstrap.Modal(document.getElementById('pwResetModal')).show();
          });
        }
        showToast(MSG['toast.password.reset.failed']);
      }).catch(function () {
        btn.disabled = false;
        showToast(MSG['toast.password.reset.failed']);
      });
  }

  document.getElementById('btnCopyResetPw').addEventListener('click', function () {
    copyToClipboard(document.getElementById('pwResetValue').value).then(function () {
      showToast(MSG['toast.password.copied']);
    });
  });

  // Workspace-key rotation, on member departure or manually (e2eEncryption design doc §7/§7.1):
  // the DEK behind every 'public'/'collabo' row never changes, only which key wraps it, so
  // "rotation" is just a fresh wrap per remaining member (their public key, already known) and
  // per shared row (their DEK, unwrapped with the OLD workspace key and re-wrapped with the new
  // one) - no content is ever re-encrypted. Runs entirely in this browser; the server only ever
  // receives the already-wrapped output (same server-blind pattern as approval, §5).
  // excludeUserNo null/undefined means "exclude nobody" (rewrap for every member) - the manual
  // rotation path uses this. onProgress(done, total), if given, is called once total is known
  // (after rotation-rows is fetched) and again after each wrap/rewrap.
  async function rotateWorkspaceKeyExcluding(excludeUserNo, onProgress) {
    const oldWsKey = await OE_SESSION_KEYS.loadWorkspaceKey();
    if (!oldWsKey) throw new Error('no cached workspace key');
    const newWsKey = await OE_CRYPTO.generateWorkspaceKey();

    const eligibleMembers = currentUsers.filter(function (u) {
      var excluded = excludeUserNo != null && String(u.userNo) === String(excludeUserNo);
      return !excluded && u.publicKey;
    });
    const rows = await (await fetch('/api/admin/workspace/rotation-rows')).json();

    const total = eligibleMembers.length + rows.length;
    let done = 0;
    if (onProgress) onProgress(done, total);

    const memberWraps = [];
    for (const u of eligibleMembers) {
      const publicKey = await OE_CRYPTO.importPublicKey(u.publicKey);
      const wrappedWsKey = await OE_CRYPTO.wrapWorkspaceKeyForUser(newWsKey, publicKey);
      memberWraps.push({ userNo: u.userNo, wrappedWsKey: wrappedWsKey });
      done++;
      if (onProgress) onProgress(done, total);
    }

    const contentRewraps = [];
    for (const row of rows) {
      const dek = await OE_CRYPTO.unwrapContentKeyWithWorkspaceKey(row.wrappedContentKey, oldWsKey);
      const wrappedContentKey = await OE_CRYPTO.wrapContentKeyWithWorkspaceKey(dek, newWsKey);
      const rewrap = { hostsId: row.hostsId, wrappedContentKey: wrappedContentKey };
      // Rows with a live public link also carry their link's own DEK, wrapped the same way
      // (e2eEncryption design doc §6 "living link" redesign) - it must rotate in lockstep with
      // wrappedContentKey or every live link would silently break on its next save.
      if (row.wrappedLinkKey) {
        const linkDek = await OE_CRYPTO.unwrapContentKeyWithWorkspaceKey(row.wrappedLinkKey, oldWsKey);
        rewrap.wrappedLinkKey = await OE_CRYPTO.wrapContentKeyWithWorkspaceKey(linkDek, newWsKey);
      }
      contentRewraps.push(rewrap);
      done++;
      if (onProgress) onProgress(done, total);
    }

    const res = await fetch('/api/admin/workspace/rotate', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ memberWraps: memberWraps, contentRewraps: contentRewraps })
    });
    if (!res.ok) throw new Error('rotation failed');
    await OE_SESSION_KEYS.saveWorkspaceKey(newWsKey);
  }

  var rotationProgressModalEl = document.getElementById('rotationProgressModal');
  var rotationProgressModal = new bootstrap.Modal(rotationProgressModalEl);
  var rotationProgressBar = document.getElementById('rotationProgressBar');
  var rotationProgressCount = document.getElementById('rotationProgressCount');

  function updateRotationProgress(done, total) {
    var pct = total > 0 ? Math.round((done / total) * 100) : 0;
    rotationProgressBar.style.width = pct + '%';
    rotationProgressCount.textContent = done + ' / ' + total;
  }

  // Shared by both rotation entry points (delete-member, manual button - design doc §7.1): shows
  // the non-dismissable progress modal for the duration of the rotation and always hides it again,
  // success or failure, leaving the outcome toast to the caller.
  async function runRotationWithProgress(excludeUserNo) {
    updateRotationProgress(0, 0);
    rotationProgressModal.show();
    try {
      await rotateWorkspaceKeyExcluding(excludeUserNo, updateRotationProgress);
    } finally {
      rotationProgressModal.hide();
    }
  }

  async function onDelete() {
    var btn = this;
    var row = btn.closest('tr');
    var userNo = row.dataset.userNo;
    if (!confirm(MSG['confirm.delete.user'])) return;
    btn.disabled = true;

    // Cheap client-side pre-check (cloudGroupService design doc §2.5 "안전장치"): the server
    // rejects this outright anyway, but without this check the client-driven rotation dance above
    // would still run first and leave the (not actually departing) sole ws_adm's own key wrap
    // stale - everyone else's wrap and every shared content key would move to a new workspace key
    // that this admin never receives. Skip rotation entirely when it's foredoomed. The server-side
    // check in apiDeleteUser remains authoritative against a stale currentUsers snapshot.
    if (row.dataset.role === ADMIN_ROLE) {
      var adminCount = currentUsers.filter(function (u) { return u.role === ADMIN_ROLE; }).length;
      if (adminCount <= 1) {
        btn.disabled = false;
        showToast(MSG['toast.last.ws.admin.blocked']);
        return;
      }
    }

    if (window.OE_WORKSPACE_MODE) {
      try {
        await runRotationWithProgress(userNo);
      } catch (e) {
        // Rotation failing must block the deletion (design doc §7.1 policy change): proceeding
        // anyway would strand the departing member with continued access to the old workspace
        // key's content. Surface it distinctly and let the ws_adm retry (delete again, or use the
        // manual "Rotate Workspace Key" button).
        btn.disabled = false;
        showToast(MSG['toast.rotation.failed']);
        return;
      }
    }

    fetch('/api/admin/users/' + userNo, { method: 'DELETE' })
      .then(function (r) {
        if (r.ok) {
          showToast(MSG['toast.user.deleted']);
          currentUsers = currentUsers.filter(function(u) { return String(u.userNo) !== String(userNo); });
          row.classList.add('oe-removing');
          setTimeout(function () { row.remove(); }, 260);
        } else {
          btn.disabled = false;
          r.clone().json().then(function (data) {
            showToast(data && data.error === 'last_ws_admin' ? MSG['toast.last.ws.admin.blocked'] : MSG['toast.user.delete.failed']);
          }).catch(function () {
            showToast(MSG['toast.user.delete.failed']);
          });
        }
      }).catch(function () {
        btn.disabled = false;
        showToast(MSG['toast.user.delete.failed']);
      });
  }

  var btnRotateWsKey = document.getElementById('btnRotateWsKey');
  if (btnRotateWsKey) {
    btnRotateWsKey.addEventListener('click', function () {
      if (!confirm(MSG['confirm.rotate.ws.key'])) return;
      btnRotateWsKey.disabled = true;
      runRotationWithProgress(null)
        .then(function () {
          showToast(MSG['toast.rotation.done']);
        })
        .catch(function () {
          showToast(MSG['toast.rotation.failed.manual']);
        })
        .finally(function () {
          btnRotateWsKey.disabled = false;
        });
    });
  }

  function loadPending() {
    fetch('/api/admin/users/pending')
      .then(function (r) { return r.json(); })
      .then(renderPending)
      .catch(function () {});
  }

  function renderPending(pending) {
    var section = document.getElementById('pendingSection');
    var tbody = document.getElementById('pendingTbody');
    if (!pending || pending.length === 0) {
      section.hidden = true;
      tbody.innerHTML = '';
      return;
    }
    section.hidden = false;
    tbody.innerHTML = pending.map(function (u) {
      return '<tr data-user-no="' + u.userNo + '" data-public-key="' + escHtml(u.publicKey || '') + '">' +
        '<td>' + escHtml(u.userId) + '</td>' +
        '<td class="small text-muted">' + escHtml(u.createAt) + '</td>' +
        '<td class="text-end">' +
        '<button class="oe-tbl-btn oe-tbl-btn-action btn-approve-pending" title="' + escHtml(MSG['users.btn.approve']) + '">' +
        '<span class="oe-icon oe-icon-grant-admin" style="width:15px;height:15px"></span></button>' +
        ' <button class="oe-tbl-btn oe-tbl-btn-delete btn-reject-pending ms-1" title="' + escHtml(MSG['users.btn.reject']) + '">' +
        '<span class="oe-icon oe-icon-delete" style="width:13px;height:13px"></span></button>' +
        '</td></tr>';
    }).join('');
    tbody.querySelectorAll('.btn-approve-pending').forEach(function (btn) {
      btn.addEventListener('click', onApprovePending);
    });
    tbody.querySelectorAll('.btn-reject-pending').forEach(function (btn) {
      btn.addEventListener('click', onRejectPending);
    });
  }

  function onApprovePending() {
    var btn = this;
    var row = btn.closest('tr');
    var userNo = row.dataset.userNo;
    var publicKeyB64 = row.dataset.publicKey;
    if (!confirm(MSG['confirm.approve.user'])) return;
    btn.disabled = true;

    approveWithWorkspaceKeyWrap(userNo, publicKeyB64).catch(function (err) {
      console.error('Approve failed:', err);
      btn.disabled = false;
      showToast(MSG['toast.user.approve.failed']);
    });
  }

  async function approveWithWorkspaceKeyWrap(userNo, publicKeyB64) {
    var row = document.querySelector('tr[data-user-no="' + userNo + '"]');
    var btn = row.querySelector('.btn-approve-pending');

    // The approving ws_adm must have their own workspace key cached from login (e2eEncryption
    // design doc §3/§5) - if not (e.g. this account predates the crypto wiring, or the cache was
    // never populated), approval can't proceed: there would be nothing correct to wrap.
    var wsKey = await OE_SESSION_KEYS.loadWorkspaceKey();
    if (!wsKey || !publicKeyB64) {
      btn.disabled = false;
      showToast(MSG['toast.user.approve.failed']);
      return;
    }
    var publicKey = await OE_CRYPTO.importPublicKey(publicKeyB64);
    var wrappedWsKey = await OE_CRYPTO.wrapWorkspaceKeyForUser(wsKey, publicKey);

    var r = await fetch('/api/admin/users/' + userNo + '/approve', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ wrappedWsKey: wrappedWsKey })
    });
    if (r.ok) {
      showToast(MSG['toast.user.approved']);
      row.remove();
      if (!document.getElementById('pendingTbody').children.length) document.getElementById('pendingSection').hidden = true;
      loadUsers('');
    } else {
      btn.disabled = false;
      showToast(MSG['toast.user.approve.failed']);
    }
  }

  function onRejectPending() {
    var btn = this;
    var row = btn.closest('tr');
    var userNo = row.dataset.userNo;
    if (!confirm(MSG['confirm.reject.user'])) return;
    btn.disabled = true;
    fetch('/api/admin/users/' + userNo + '/reject', { method: 'POST' })
      .then(function (r) {
        if (r.ok) {
          showToast(MSG['toast.user.rejected']);
          row.remove();
          if (!document.getElementById('pendingTbody').children.length) document.getElementById('pendingSection').hidden = true;
        } else {
          btn.disabled = false;
          showToast(MSG['toast.user.reject.failed']);
        }
      }).catch(function () {
        btn.disabled = false;
        showToast(MSG['toast.user.reject.failed']);
      });
  }

  function loadInvites() {
    var tbody = document.getElementById('invitesTbody');
    if (!tbody) return; // workspace mode only - section isn't rendered in standalone
    fetch('/api/admin/invites')
      .then(function (r) { return r.json(); })
      .then(renderInvites)
      .catch(function () {});
  }

  function renderInvites(invites) {
    var tbody = document.getElementById('invitesTbody');
    if (!invites || invites.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" class="text-muted text-center py-3">' + escHtml(MSG['users.invite.empty']) + '</td></tr>';
      return;
    }
    tbody.innerHTML = invites.map(function (i) {
      return '<tr data-invite-code="' + escHtml(i.inviteCode) + '">' +
        '<td class="small text-muted">' + escHtml(i.teamName || '-') + '</td>' +
        '<td class="setup-mono">' + escHtml(i.inviteCode) + '</td>' +
        '<td class="small text-muted">' + escHtml(i.expiresAt) + '</td>' +
        '<td class="text-end"><button class="oe-tbl-btn oe-tbl-btn-action btn-copy-invite" title="' + escHtml(MSG['ui.copy.clipboard']) + '">' +
        '<span class="oe-icon oe-icon-copy" style="width:13px;height:13px"></span></button></td></tr>';
    }).join('');
    tbody.querySelectorAll('.btn-copy-invite').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var code = btn.closest('tr').dataset.inviteCode;
        var url = location.origin + '/register?invite=' + encodeURIComponent(code);
        copyToClipboard(url).then(function () { showToast(MSG['toast.copied']); });
      });
    });
  }

  var btnCreateInvite = document.getElementById('btnCreateInvite');
  if (btnCreateInvite) {
    btnCreateInvite.addEventListener('click', function () {
      btnCreateInvite.disabled = true;
      var teamSelect = document.getElementById('inviteTeamSelect');
      var teamNo = teamSelect && teamSelect.value ? Number(teamSelect.value) : null;
      fetch('/api/admin/invites', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ teamNo: teamNo })
      })
        .then(function (r) {
          btnCreateInvite.disabled = false;
          if (r.ok) { loadInvites(); return; }
          showToast(MSG['toast.invite.create.failed']);
        }).catch(function () {
          btnCreateInvite.disabled = false;
          showToast(MSG['toast.invite.create.failed']);
        });
    });
  }

  // Team management (cloudGroupService design doc §2.9) - list/create/rename/delete, plus keeping
  // the invite modal's team dropdown and every member row's reassignment dropdown in sync.
  function loadTeams() {
    var tbody = document.getElementById('teamsTbody');
    if (!tbody) return; // workspace mode only - section isn't rendered in standalone
    fetch('/api/admin/teams')
      .then(function (r) { return r.json(); })
      .then(function (teams) {
        currentTeams = teams;
        renderTeams(teams);
        renderInviteTeamOptions(teams);
        renderUsers(currentUsers);
      })
      .catch(function () {});
  }

  function renderInviteTeamOptions(teams) {
    var select = document.getElementById('inviteTeamSelect');
    if (!select) return;
    if (!teams || teams.length === 0) {
      select.hidden = true;
      select.innerHTML = '';
      return;
    }
    select.hidden = false;
    select.innerHTML = '<option value="">' + escHtml(MSG['teams.select.none']) + '</option>' +
      teams.map(function (t) { return '<option value="' + t.teamNo + '">' + escHtml(t.teamName) + '</option>'; }).join('');
  }

  function renderTeams(teams) {
    var tbody = document.getElementById('teamsTbody');
    if (!teams || teams.length === 0) {
      tbody.innerHTML = '<tr><td colspan="2" class="text-muted text-center py-3">' + escHtml(MSG['teams.empty']) + '</td></tr>';
      return;
    }
    tbody.innerHTML = teams.map(function (t) {
      return '<tr data-team-no="' + t.teamNo + '">' +
        '<td><span class="team-name-text" tabindex="0" title="' + escHtml(MSG['tooltip.rename.team']) + '">' + escHtml(t.teamName) + '</span></td>' +
        '<td class="text-end"><button class="oe-tbl-btn oe-tbl-btn-delete btn-delete-team" title="' + escHtml(MSG['tooltip.delete.team']) + '">' +
        '<span class="oe-icon oe-icon-delete" style="width:13px;height:13px"></span></button></td></tr>';
    }).join('');
    tbody.querySelectorAll('.team-name-text').forEach(function (span) {
      span.addEventListener('dblclick', function () { startTeamRename(span); });
    });
    tbody.querySelectorAll('.btn-delete-team').forEach(function (btn) {
      btn.addEventListener('click', onDeleteTeam);
    });
  }

  // Double-click-to-rename, same interaction as hosts.pebble's profile rename - contentEditable
  // in place rather than a separate edit form, since a team is just a name.
  function startTeamRename(span) {
    var original = span.textContent;
    span.contentEditable = 'true';
    span.classList.add('editing');
    span.focus();
    var range = document.createRange();
    range.selectNodeContents(span);
    window.getSelection().removeAllRanges();
    window.getSelection().addRange(range);

    function finish(save) {
      span.contentEditable = 'false';
      span.classList.remove('editing');
      span.removeEventListener('blur', onBlur);
      span.removeEventListener('keydown', onKeydown);
      var newName = span.textContent.trim();
      if (!save || !newName || newName === original) {
        span.textContent = original;
        return;
      }
      var row = span.closest('tr');
      var teamNo = row.dataset.teamNo;
      fetch('/api/admin/teams/' + teamNo, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ teamName: newName })
      }).then(function (r) {
        if (r.ok) {
          showToast(MSG['toast.team.renamed']);
          var t = currentTeams.find(function (t) { return String(t.teamNo) === String(teamNo); });
          if (t) t.teamName = newName;
          span.textContent = newName;
          renderInviteTeamOptions(currentTeams);
          renderUsers(currentUsers);
        } else if (r.status === 409) {
          showToast(MSG['toast.team.name.exists']);
          span.textContent = original;
        } else {
          showToast(MSG['toast.team.rename.failed']);
          span.textContent = original;
        }
      }).catch(function () {
        showToast(MSG['toast.team.rename.failed']);
        span.textContent = original;
      });
    }

    function onBlur() { finish(true); }
    function onKeydown(e) {
      if (e.key === 'Enter') { e.preventDefault(); span.blur(); }
      else if (e.key === 'Escape') { finish(false); span.blur(); }
    }
    span.addEventListener('blur', onBlur);
    span.addEventListener('keydown', onKeydown);
  }

  function onDeleteTeam() {
    var btn = this;
    var row = btn.closest('tr');
    var teamNo = row.dataset.teamNo;
    if (!confirm(MSG['confirm.delete.team'])) return;
    btn.disabled = true;
    fetch('/api/admin/teams/' + teamNo, { method: 'DELETE' })
      .then(function (r) {
        if (r.ok) {
          showToast(MSG['toast.team.deleted']);
          currentTeams = currentTeams.filter(function (t) { return String(t.teamNo) !== String(teamNo); });
          renderTeams(currentTeams);
          renderInviteTeamOptions(currentTeams);
        } else if (r.status === 409) {
          btn.disabled = false;
          showToast(MSG['toast.team.delete.in.use']);
        } else {
          btn.disabled = false;
          showToast(MSG['toast.team.delete.failed']);
        }
      }).catch(function () {
        btn.disabled = false;
        showToast(MSG['toast.team.delete.failed']);
      });
  }

  var btnCreateTeam = document.getElementById('btnCreateTeam');
  if (btnCreateTeam) {
    var newTeamNameInput = document.getElementById('newTeamName');
    btnCreateTeam.addEventListener('click', function () {
      var name = newTeamNameInput.value.trim();
      if (!name) return;
      btnCreateTeam.disabled = true;
      fetch('/api/admin/teams', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ teamName: name })
      }).then(function (r) {
        btnCreateTeam.disabled = false;
        if (r.ok) {
          newTeamNameInput.value = '';
          showToast(MSG['toast.team.created']);
          loadTeams();
          return;
        }
        if (r.status === 409) { showToast(MSG['toast.team.name.exists']); return; }
        showToast(MSG['toast.team.create.failed']);
      }).catch(function () {
        btnCreateTeam.disabled = false;
        showToast(MSG['toast.team.create.failed']);
      });
    });
    newTeamNameInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); btnCreateTeam.click(); }
    });
  }

  loadUsers('');
  loadPending();
  loadInvites();
  loadTeams();
})();
</script>
<script>initWidthToggle(document.getElementById('usersApp'), document.getElementById('btnToggleWidth'));</script>
{% endblock %}
