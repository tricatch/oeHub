{% extends "templates/app-layout.pebble" %}

{% block title %}{{ msg['settings.title'] }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/css/oe-panel.css">
<link rel="stylesheet" href="/css/settings.css">
<link rel="stylesheet" href="/css/info-page.css">
{% endblock %}

{% block content %}
<div class="settings-app" id="settingsApp">
<script nonce="{{ cspNonce }}">
  (function() {
    if (localStorage.getItem('oeWidthExpanded') === 'true') {
      document.getElementById('settingsApp').classList.add('expanded');
      document.body.classList.add('oe-expanded');
    }
  })();
</script>

  <div class="settings-main">

    <h5>{{ msg['settings.title'] }}</h5>

    {# oeProxy-only sections (CA, forward proxy, identifier, upstream certificate): workspace mode never runs oeProxy #}
    {% if not workspaceMode %}
    {# ── oeHosts (PROXY_SVR address, forward proxy status, allowed domains) ── #}
    <div class="oe-info-section">
      <table class="oe-info-table oe-info-table-fixed mb-0">
        <colgroup><col style="width:140px;"><col></colgroup>
        <thead>
          <tr>
            <th colspan="2">{{ msg['settings.oehosts.title'] }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="oe-info-label">{{ msg['settings.proxysvr.title'] }}</td>
            <td>
              <input type="text" id="proxySvrAddress" class="form-control form-control-sm" style="max-width:260px;"
                     value="{{ proxySvrAddress }}" placeholder="127.0.0.1">
              <div class="form-text">{{ msg['settings.proxysvr.help'] }}</div>
            </td>
          </tr>
          <tr>
            <td class="oe-info-label">{{ msg['settings.fwdproxy.status'] }}</td>
            <td>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="fwdproxyEnabled" checked disabled>
                <label class="form-check-label" for="fwdproxyEnabled">{{ msg['settings.fwdproxy.label'] }}</label>
              </div>
              <div class="form-text">{{ msg['settings.fwdproxy.help'] }}</div>
              <label class="form-label small mt-2 mb-1">{{ msg['settings.allowed.title'] }}</label>
              <textarea id="allowedDomains" class="form-control form-control-sm" rows="4"
                        placeholder="*.example.com&#10;hub.example.com">{{ allowedDomains }}</textarea>
              <div class="form-text">{{ msg['settings.allowed.help'] }}</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    {% endif %}

    {% include "templates/oehub/_preset-tables.pebble" %}

    {% if not workspaceMode %}
    {# ── oeProxy (identifier, upstream certificate, upstream address, oeOID domains) ── #}
    <div class="oe-info-section">
      <table class="oe-info-table oe-info-table-fixed mb-0">
        <colgroup><col style="width:140px;"><col></colgroup>
        <thead>
          <tr>
            <th colspan="2">{{ msg['settings.oeproxy.title'] }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="oe-info-label">{{ msg['settings.identifier.title'] }}</td>
            <td>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="identifierOid" checked disabled>
                <label class="form-check-label" for="identifierOid">{{ msg['settings.identifier.oid'] }}</label>
                <span class="text-muted small">{{ msg['settings.identifier.oid.hint'] }}</span>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="identifierIp" {% if ipIdentifierEnabled %}checked{% endif %}>
                <label class="form-check-label" for="identifierIp">{{ msg['settings.identifier.ip'] }}</label>
              </div>
              <div class="form-text">{{ msg['settings.identifier.help'] }}</div>
            </td>
          </tr>
          <tr>
            <td class="oe-info-label">{{ msg['settings.oeproxy.oeoid.label'] }}</td>
            <td>
              <textarea id="oidDomainDefault" class="form-control form-control-sm" rows="2"
                        placeholder="*.foo.oe&#10;*.bar.oe">{{ oidDomainDefault }}</textarea>
              <div class="form-text">{{ msg['settings.oeoid.help'] }}</div>
            </td>
          </tr>
          <tr>
            <td class="oe-info-label">{{ msg['settings.trustcert.title'] }}</td>
            <td>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="trustInternalCert" {% if trustInternalCertEnabled %}checked{% endif %}>
                <label class="form-check-label" for="trustInternalCert">{{ msg['settings.trustcert.enable'] }}</label>
              </div>
              <div class="form-text">{{ msg['settings.trustcert.help'] }}</div>
            </td>
          </tr>
          <tr>
            <td class="oe-info-label">{{ msg['settings.upstream.title'] }}</td>
            <td>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="internalOnlyUpstream" {% if internalOnlyUpstream %}checked{% endif %}>
                <label class="form-check-label" for="internalOnlyUpstream">{{ msg['settings.upstream.enable'] }}</label>
              </div>
              <div class="form-text">{{ msg['settings.upstream.help'] }}</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    {# ── CA Certificate ── #}
    <div class="oe-info-section">
      <table class="oe-info-table oe-info-table-fixed mb-0">
        <colgroup><col style="width:140px;"><col></colgroup>
        <thead>
          <tr>
            <th colspan="2">
              <div class="d-flex align-items-center justify-content-between">
                <span>oeProxy - Root CA</span>
                {% if ca.configured %}
                <button class="oe-nav-action-btn"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#caConfigureDiv"
                        aria-expanded="{% if caError %}true{% else %}false{% endif %}"
                        title="{{ msg['settings.ca.reconfigure'] }}">
                  <span class="oe-icon oe-icon-reconfigure" style="width:13px;height:13px"></span>
                </button>
                {% endif %}
              </div>
            </th>
          </tr>
        </thead>
        {% if ca.configured and not ca.parseError %}
        <tbody>
          <tr>
            <td class="oe-info-label">{{ msg['settings.ca.subject'] }}</td>
            <td class="text-break ca-info-mono">{{ ca.subject }}</td>
          </tr>
          <tr>
            <td class="oe-info-label">{{ msg['settings.ca.serial'] }}</td>
            <td class="ca-info-mono">{{ ca.serial }}</td>
          </tr>
          <tr>
            <td class="oe-info-label">{{ msg['settings.ca.valid.from'] }}</td>
            <td>{{ ca.notBefore }}</td>
          </tr>
          <tr>
            <td class="oe-info-label">{{ msg['settings.ca.valid.until'] }}</td>
            <td>{{ ca.notAfter }}</td>
          </tr>
        </tbody>
        {% endif %}
      </table>

      <div class="pt-3">

        {% if caSuccess %}
        <div class="alert alert-success py-2 small mb-3">{{ msg[caSuccess] }}</div>
        {% endif %}

        {% if ca.configured and ca.parseError %}
        <div class="alert alert-warning py-2 small mb-3">
          {{ msg['settings.ca.parse.error'] }}
        </div>
        {% endif %}

        {% if not ca.configured %}
        <p class="text-muted small mb-3">{{ msg['settings.ca.no.cert'] }}</p>
        {% endif %}

        {# Generate / Import form (always shown when not configured; collapsible when configured) #}
        <div id="caConfigureDiv"
             class="{% if ca.configured %}collapse{% endif %} {% if caError %}show{% endif %}">

          {% if ca.configured %}<hr class="mt-0 mb-3">{% endif %}

          {% if caError %}
          <div class="alert alert-danger py-2 small mb-3">{{ msg[caError] }}</div>
          {% endif %}

          <div class="alert alert-warning py-2 small mb-3 ca-note-text">
            <strong>{{ msg['setup.ca.note.label'] }}:</strong> {{ msg['settings.ca.warning'] }}
          </div>

          <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link {% if caActiveTab != "import" %}active{% endif %}"
                      data-bs-toggle="tab" data-bs-target="#caGeneratePane"
                      type="button" role="tab">{{ msg['settings.ca.tab.generate'] }}</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link {% if caActiveTab == "import" %}active{% endif %}"
                      data-bs-toggle="tab" data-bs-target="#caImportPane"
                      type="button" role="tab">{{ msg['settings.ca.tab.import'] }}</button>
            </li>
          </ul>

          <div class="tab-content">

            {# Generate tab #}
            <div class="tab-pane fade {% if caActiveTab != "import" %}show active{% endif %}"
                 id="caGeneratePane" role="tabpanel">
              <form method="post" action="/adm/settings/ca/generate" autocomplete="off">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <div class="mb-3">
                  <label class="form-label">{{ msg['settings.ca.name.label'] }}</label>
                  <input type="text" name="caName" class="form-control"
                         value="{{ defaultCaName }}" placeholder="{{ msg['setup.ca.name.placeholder'] }}" required>
                  <div class="form-text">{{ msg['settings.ca.name.help'] }}</div>
                </div>
                <button type="submit" class="oe-modal-btn ca-action-btn">
                  <span class="oe-icon oe-icon-cert" style="width:13px;height:13px"></span>{{ msg['settings.ca.generate.btn'] }}
                </button>
              </form>
            </div>

            {# Import tab #}
            <div class="tab-pane fade {% if caActiveTab == "import" %}show active{% endif %}"
                 id="caImportPane" role="tabpanel">
              <form method="post" action="/adm/settings/ca/import"
                    enctype="multipart/form-data" autocomplete="off">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <div class="mb-3">
                  <label class="form-label">{{ msg['settings.ca.cert.file'] }} <span class="text-muted fw-normal">(.cer / .pem / .crt)</span></label>
                  <input type="file" name="certFile" class="form-control"
                         accept=".cer,.pem,.crt" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">{{ msg['settings.ca.key.file'] }} <span class="text-muted fw-normal">(.pfx / .p12)</span></label>
                  <input type="file" name="keyFile" class="form-control"
                         accept=".pfx,.p12,.pem" required>
                </div>
                <button type="submit" class="oe-modal-btn ca-action-btn">
                  <span class="oe-icon oe-icon-cert" style="width:13px;height:13px"></span>{{ msg['settings.ca.import.btn'] }}
                </button>
              </form>
            </div>

          </div>{# /tab-content #}
        </div>{# /caConfigureDiv #}

      </div>
    </div>

    {% endif %}

    {# ── Backup ── #}
    <div class="oe-info-section">
      <table class="oe-info-table oe-info-table-fixed mb-0">
        <colgroup><col style="width:140px;"><col></colgroup>
        <thead>
          <tr>
            <th colspan="2">{{ msg['settings.backup.title'] }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="oe-info-label">{{ msg['settings.backup.interval.label'] }}</td>
            <td>
              <select id="backupIntervalHours" class="form-select form-select-sm" style="width:auto;display:inline-block;">
                {% for h in 1..24 %}
                <option value="{{ h }}"{% if h == backupIntervalHours %} selected{% endif %}>{{ h }}{{ msg[h == 1 ? 'settings.backup.interval.hour' : 'settings.backup.interval.hours'] }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ msg['settings.backup.interval.help'] }}</div>
            </td>
          </tr>
          <tr>
            <td class="oe-info-label">{{ msg['settings.backup.last.label'] }}</td>
            <td>{{ backupLastAt is not empty ? backupLastAt : msg['settings.backup.last.none'] }}</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>


</div>
<script nonce="{{ cspNonce }}">initWidthToggle(document.getElementById('settingsApp'), document.getElementById('btnToggleWidth'));</script>

{% set presetApiBase = '/api/adm/hosts' %}
{% include "templates/oehub/_preset-scripts.pebble" %}

<script nonce="{{ cspNonce }}">
  {% if not workspaceMode %}
  (() => {
    const proxySvrEl = document.getElementById('proxySvrAddress');
    let lastProxySvrAddress = proxySvrEl.value;
    proxySvrEl.addEventListener('blur', async () => {
      const address = proxySvrEl.value;
      if (address === lastProxySvrAddress) return;
      const res = await fetch('/api/adm/settings/proxy-svr-address', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({address})
      });
      if (res.ok) {
        var saved = await res.json();
        proxySvrEl.value = saved.address;
        lastProxySvrAddress = saved.address;
        showToast(MSG['settings.saved']);
      }
    });
  })();
  {% endif %}

  {% if not workspaceMode %}
  (() => {
    const oidEl = document.getElementById('oidDomainDefault');
    let lastOidDomainList = oidEl.value;
    oidEl.addEventListener('blur', async () => {
      const domainList = oidEl.value;
      if (domainList === lastOidDomainList) return;
      const res = await fetch('/api/adm/settings/oid-domain-default', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({domainList})
      });
      if (res.ok) { lastOidDomainList = domainList; showToast(MSG['settings.saved']); }
    });
  })();
  {% endif %}

  {% if not workspaceMode %}
  (() => {
    const allowedEl = document.getElementById('allowedDomains');
    let lastAllowedDomains = allowedEl.value;
    allowedEl.addEventListener('blur', async () => {
      const domains = allowedEl.value;
      if (domains === lastAllowedDomains) return;
      const res = await fetch('/api/adm/settings/allowed-domains', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({domains})
      });
      if (res.ok) { lastAllowedDomains = domains; showToast(MSG['settings.saved']); }
    });
  })();
  {% endif %}

  document.getElementById('backupIntervalHours').addEventListener('change', async e => {
    const intervalHours = e.target.value;
    const res = await fetch('/api/adm/settings/backup-interval', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({intervalHours: parseInt(intervalHours, 10)})
    });
    if (res.ok) showToast(MSG['settings.saved']);
  });

  {% if not workspaceMode %}
  document.getElementById('identifierIp').addEventListener('change', async e => {
    const ipEnabled = e.target.checked;
    const res = await fetch('/api/adm/settings/identifier', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ipEnabled})
    });
    if (res.ok) showToast(MSG['settings.saved']);
    else e.target.checked = !ipEnabled;
  });

  document.getElementById('trustInternalCert').addEventListener('change', async e => {
    const enabled = e.target.checked;
    const res = await fetch('/api/adm/settings/trust-internal-cert', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({enabled})
    });
    if (res.ok) showToast(MSG['settings.saved']);
    else e.target.checked = !enabled;
  });
  {% endif %}

  {% if not workspaceMode %}
  document.getElementById('internalOnlyUpstream').addEventListener('change', async e => {
    const enabled = e.target.checked;
    const res = await fetch('/api/adm/settings/internal-only-upstream', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({enabled})
    });
    if (res.ok) showToast(MSG['settings.saved']);
    else e.target.checked = !enabled;
  });
  {% endif %}
</script>
{% endblock %}
