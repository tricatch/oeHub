{# Wires the two preset tables of _preset-tables.pebble to their API. The including page sets
   presetApiBase to the prefix serving them ('/api/adm/hosts' or '/api/wsa/hosts'). #}
<script src="/js/preset-table.js"></script>
<script nonce="{{ cspNonce }}">
  initUaPresetTable({
    apiBase: '{{ presetApiBase }}/ua',
    deleteTooltipKey: 'tooltip.ua.delete',
    savedToastKey: 'toast.ua.saved',
    deletedToastKey: 'toast.ua.deleted'
  });
  initUrlPresetTable({
    apiBase: '{{ presetApiBase }}/url',
    deleteTooltipKey: 'tooltip.url.delete',
    savedToastKey: 'toast.url.saved',
    deletedToastKey: 'toast.url.deleted'
  });
</script>
