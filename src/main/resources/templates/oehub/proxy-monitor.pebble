{% extends "templates/app-layout.pebble" %}

{% block title %}oeProxy Monitor{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/css/monitor.css">
{% endblock %}

{% block navActions %}
<span class="oe-nav-sub-label">{{ msg['monitor.page.title'] }}</span>
<div class="oe-nav-actions">
  <button class="oe-nav-action-btn monitor-record-btn recording" id="btnRecordToggle" title="{{ msg['monitor.stop.recording'] }}">
    <span id="icon-stop" class="oe-icon oe-icon-stop" style="width:15px;height:15px"></span>
    <span id="icon-start" class="icon-hidden oe-icon oe-icon-record" style="width:15px;height:15px"></span>
  </button>
  <button class="oe-nav-action-btn oe-nav-action-danger" id="btnClear" title="{{ msg['tooltip.clear'] }}">
    <span class="oe-icon oe-icon-clear" style="width:15px;height:15px"></span>
  </button>
  <div class="oe-nav-action-divider"></div>
  <button class="oe-nav-action-btn monitor-eventlog-btn" id="btnEventLog" title="{{ msg['monitor.sse.off'] }}">
    <span class="oe-icon oe-icon-sse" style="width:15px;height:15px"></span>
  </button>
</div>
{% endblock %}

{% block pageClass %}monitor-main{% endblock %}

{% block content %}
<div class="monitor-app" id="monitorApp">
<script>if(localStorage.getItem('oeWidthExpanded')==='true') document.getElementById('monitorApp').classList.add('expanded');</script>

  <div class="monitor-log-pane" id="monitor-log-list">
    <table class="monitor-table">
      <thead>
        <tr>
          <th>{{ msg['monitor.col.method'] }}</th>
          <th>{{ msg['monitor.col.host'] }}</th>
          <th>{{ msg['monitor.col.path'] }}</th>
          <th>{{ msg['monitor.col.start'] }}</th>
          <th>{{ msg['monitor.col.duration'] }}</th>
          <th>{{ msg['monitor.col.code'] }}</th>
          <th>{{ msg['monitor.col.size'] }}</th>
        </tr>
      </thead>
      <tbody id="monitor-log-tbody"></tbody>
    </table>
  </div>

  <div class="monitor-splitter" id="monitor-splitter"></div>

  <div class="monitor-detail">
    <div class="monitor-tabs">
      <button type="button" class="monitor-tab-btn active" data-tab="header">{{ msg['monitor.tab.header'] }}</button>
      <button type="button" class="monitor-tab-btn" data-tab="cookie">{{ msg['monitor.tab.cookie'] }}</button>
      <button type="button" class="monitor-tab-btn" data-tab="request">{{ msg['monitor.tab.request'] }}</button>
      <button type="button" class="monitor-tab-btn" data-tab="response">{{ msg['monitor.tab.response'] }}</button>
      <button type="button" class="monitor-tab-btn" data-tab="websocket">{{ msg['monitor.tab.websocket'] }}</button>
      <button type="button" class="monitor-tab-btn monitor-tab-push-right" data-tab="event">{{ msg['monitor.tab.event'] }}</button>
    </div>
    <div class="monitor-panels">
      <div id="detail-header"    class="monitor-panel active is-empty">{{ msg['monitor.detail.empty'] }}</div>
      <div id="detail-cookie"    class="monitor-panel is-empty">{{ msg['monitor.detail.empty'] }}</div>
      <div id="detail-request"   class="monitor-panel is-empty">{{ msg['monitor.detail.empty'] }}</div>
      <div id="detail-response"  class="monitor-panel is-empty">{{ msg['monitor.detail.empty'] }}</div>
      <div id="detail-websocket" class="monitor-panel is-empty">{{ msg['monitor.detail.empty'] }}</div>
      <div id="detail-event"     class="monitor-panel is-empty">{{ msg['monitor.sse.disabled'] }}</div>
    </div>
  </div>

</div>

{% if not proxyActive %}
<div class="modal fade" id="modalProxyInactive" tabindex="-1" aria-labelledby="modalProxyInactiveLabel">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header">
        <h5 class="modal-title" id="modalProxyInactiveLabel">{{ msg['monitor.proxy.inactive.title'] }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-0">{{ msg['monitor.proxy.inactive.body'] }}</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="oe-modal-btn oe-modal-btn-plain" data-bs-dismiss="modal">{{ msg['btn.close'] }}</button>
        <a href="/oehub/proxy" class="oe-modal-btn">{{ msg['monitor.proxy.goto.proxy'] }}</a>
      </div>
    </div>
  </div>
</div>
{% endif %}

<script>
(function() {
  var logList   = document.getElementById('monitor-log-list');
  var logTbody  = document.getElementById('monitor-log-tbody');
  var btnRecord = document.getElementById('btnRecordToggle');
  var btnClear  = document.getElementById('btnClear');
  var btnEvent  = document.getElementById('btnEventLog');
  var iconStop  = document.getElementById('icon-stop');
  var iconStart = document.getElementById('icon-start');
  var isRecording = true;

  /* ── Tab switching ──────────────────────────────────────── */
  document.querySelectorAll('.monitor-tab-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var tab = this.getAttribute('data-tab');
      document.querySelectorAll('.monitor-tab-btn').forEach(function(b) { b.classList.remove('active'); });
      document.querySelectorAll('.monitor-panel').forEach(function(p) { p.classList.remove('active'); });
      this.classList.add('active');
      var panel = document.getElementById('detail-' + tab);
      if (panel) {
        panel.classList.add('active');
        panel.scrollTop = (tab === 'event') ? panel.scrollHeight : 0;
      }
    });
  });

  /* ── Row click ──────────────────────────────────────────── */
  logList.addEventListener('click', function(e) {
    var row = e.target.closest('tr[data-rid]');
    if (!row) return;
    logTbody.querySelectorAll('tr[data-rid]').forEach(function(r) { r.classList.remove('active'); });
    row.classList.add('active');
    selectedRid = row.getAttribute('data-rid');
    populateDetail(selectedRid);
  });

  /* ── Clear ──────────────────────────────────────────────── */
  btnClear.addEventListener('click', function() {
    logTbody.innerHTML = '';
    ridStartMap = {}; ridRowData = {}; selectedRid = null;
    clearEventLog();
    populateDetail(null);
  });

  /* ── Record toggle ──────────────────────────────────────── */
  btnRecord.addEventListener('click', function() {
    isRecording = !isRecording;
    btnRecord.classList.toggle('recording', isRecording);
    iconStop.classList.toggle('icon-hidden', !isRecording);
    iconStart.classList.toggle('icon-hidden', isRecording);
    btnRecord.title = isRecording ? MSG['monitor.stop.recording'] : MSG['monitor.start.recording'];
  });

  /* ── Event log toggle ───────────────────────────────────── */
  var isEventLogEnabled = false;
  btnEvent.addEventListener('click', function() {
    isEventLogEnabled = !isEventLogEnabled;
    btnEvent.classList.toggle('event-log-on', isEventLogEnabled);
    btnEvent.title = isEventLogEnabled ? MSG['monitor.sse.on'] : MSG['monitor.sse.off'];
    refreshEventPanelView();
  });

  var sseLogSeq = 0, sseLogLines = [];

  function getEventPanelEmptyPlaceholder() {
    return isEventLogEnabled ? MSG['monitor.sse.empty'] : MSG['monitor.sse.disabled'];
  }
  function refreshEventPanelView() {
    var panel = document.getElementById('detail-event');
    if (!panel) return;
    var hasLog = sseLogLines.length > 0;
    panel.textContent = hasLog ? sseLogLines.join('\n\n') : getEventPanelEmptyPlaceholder();
    panel.classList.toggle('is-empty', !hasLog);
  }
  function appendEventLog(raw) {
    if (!isEventLogEnabled) return;
    sseLogSeq++;
    sseLogLines.push('--- ' + sseLogSeq + ' @ ' + new Date().toISOString() + ' ---\n' + String(raw));
    var panel = document.getElementById('detail-event');
    if (!panel) return;
    panel.textContent = sseLogLines.join('\n\n');
    panel.classList.remove('is-empty');
    requestAnimationFrame(function() { if (panel) panel.scrollTop = panel.scrollHeight; });
  }
  function clearEventLog() { sseLogSeq = 0; sseLogLines = []; refreshEventPanelView(); }

  /* ── Data helpers ───────────────────────────────────────── */
  var ridStartMap = {}, ridRowData = {}, selectedRid = null;

  function parseFirstHeaderLine(h) {
    return (h && Array.isArray(h) && h.length && typeof h[0] === 'string') ? h[0].trim() : null;
  }
  function getHeaderValue(h, name) {
    if (!h || !Array.isArray(h)) return null;
    var low = name.toLowerCase();
    for (var i = 1; i < h.length; i++) {
      var line = typeof h[i] === 'string' ? h[i].trim() : '';
      if (line.toLowerCase().indexOf(low + ':') === 0) return line.substring(line.indexOf(':') + 1).trim();
    }
    return null;
  }
  function getAllHeaderValues(h, name) {
    if (!h || !Array.isArray(h)) return [];
    var low = name.toLowerCase(), out = [];
    for (var i = 1; i < h.length; i++) {
      var line = typeof h[i] === 'string' ? h[i].trim() : '';
      if (line.toLowerCase().indexOf(low + ':') === 0) out.push(line.substring(line.indexOf(':') + 1).trim());
    }
    return out;
  }
  function parseRequestLine(line) {
    var p = (line || '').split(/\s+/);
    return p.length >= 2 ? { method: p[0], path: p[1] } : { method: '-', path: line || '-' };
  }
  function parseResponseLine(line) {
    var p = (line || '').split(/\s+/);
    return p.length >= 2 ? p[1] : null;
  }
  function formatTime(ms) {
    if (ms == null || ms < 0) return '-';
    return ms < 1000 ? ms + ' ms' : (ms / 1000).toFixed(2) + ' s';
  }
  function formatStart(ts) {
    if (!ts || ts <= 0) return '-';
    var d = new Date(ts);
    return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2)+'.'+('00'+d.getMilliseconds()).slice(-3);
  }
  function formatSize(b) {
    if (b == null || b < 0) return '-';
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b/1024).toFixed(1).replace(/\.0$/,'') + ' KB';
    return (b/1048576).toFixed(1).replace(/\.0$/,'') + ' MB';
  }
  function formatPath(p) {
    if (!p || p === '') return '/';
    if (p === '-' || p.indexOf('?') < 0) return p;
    return p.length <= 100 ? p : p.substring(0, 97) + '...';
  }
  function buildDisplay(d) {
    var pf = d.path || '/';
    return { method: d.method||'-', host: d.host||'-', path: formatPath(pf), pathFull: pf,
             start: formatStart(d.startTs), duration: formatTime(d.timeMs), code: d.code||'-', size: formatSize(d.size) };
  }
  function findRow(rid) { return logTbody ? logTbody.querySelector('tr[data-rid="'+rid+'"]') : null; }

  function addRow(rid, disp) {
    var tr = document.createElement('tr');
    tr.setAttribute('data-rid', rid);
    tr.innerHTML =
      '<td class="col-method">'+escHtml(disp.method)+'</td>'+
      '<td class="col-host">'+escHtml(disp.host)+'</td>'+
      '<td class="col-path" title="'+escHtml(disp.pathFull)+'">'+escHtml(disp.path)+'</td>'+
      '<td class="col-start">'+escHtml(disp.start)+'</td>'+
      '<td class="col-duration">'+escHtml(disp.duration)+'</td>'+
      '<td class="col-code">'+escHtml(disp.code)+'</td>'+
      '<td class="col-size">'+escHtml(disp.size)+'</td>';
    var newTs = (ridRowData[rid] && ridRowData[rid].startTs != null) ? ridRowData[rid].startTs : 0;
    var rows = logTbody.querySelectorAll('tr[data-rid]'), insertBefore = null;
    for (var i = 0; i < rows.length; i++) {
      var ex = rows[i].getAttribute('data-rid');
      if ((ridRowData[ex] && ridRowData[ex].startTs || 0) > newTs) { insertBefore = rows[i]; break; }
    }
    logTbody.insertBefore(tr, insertBefore);
    if (!insertBefore) requestAnimationFrame(function() { logList.scrollTop = logList.scrollHeight; });
  }
  function updateRow(row, disp) {
    row.querySelector('.col-method').textContent = disp.method;
    row.querySelector('.col-host').textContent = disp.host;
    var pc = row.querySelector('.col-path'); pc.textContent = disp.path; pc.title = disp.pathFull;
    row.querySelector('.col-start').textContent = disp.start;
    row.querySelector('.col-duration').textContent = disp.duration;
    row.querySelector('.col-code').textContent = disp.code;
    row.querySelector('.col-size').textContent = disp.size;
  }

  function upsertRow(data) {
    if (!logTbody || !isRecording) return;
    var rid = data.rid || ''; if (!rid) return;
    var type = data.type || '', ts = data.timestamp || 0, headers = data.headers, body = data.body;
    if ((type==='REQ_BODY'||type==='RES_HEADER'||type==='RES_BODY'||type==='WS_FRAME') && !findRow(rid)) return;
    if (!ridRowData[rid]) ridRowData[rid] = { method:'-', host:'-', path:'/', startTs: ts };

    if (type === 'WS_FRAME') {
      if (!ridRowData[rid].wsFrames) ridRowData[rid].wsFrames = [];
      ridRowData[rid].wsFrames.push({ opcode: data.opcode||0, direction: data.wsDirection||'-', body: body, timestamp: ts });
      if (rid === selectedRid) updateWsPanel(rid);
      return;
    }
    if (type === 'REQ_HEADER') {
      ridStartMap[rid] = ts; ridRowData[rid].reqHeaders = headers; ridRowData[rid].startTs = ts;
      var rl = parseRequestLine(parseFirstHeaderLine(headers));
      ridRowData[rid].method = rl.method; ridRowData[rid].path = rl.path;
      var host = getHeaderValue(headers, 'Host'); if (host) ridRowData[rid].host = host;
      var cl = getHeaderValue(headers, 'Content-Length'); if (cl) { var n=parseInt(cl,10); if(!isNaN(n)) ridRowData[rid].size=n; }
    } else if (type === 'REQ_BODY' && body != null) {
      ridRowData[rid].reqBody = body;
    } else if (type === 'RES_HEADER') {
      ridRowData[rid].resHeaders = headers || [];
      var fl = parseFirstHeaderLine(headers); ridRowData[rid].code = fl ? (parseResponseLine(fl)||'-') : '-';
      var sts = ridStartMap[rid]; ridRowData[rid].startTs = ridRowData[rid].startTs || sts;
      ridRowData[rid].timeMs = (sts && ts) ? ts - sts : null;
      var cl2 = getHeaderValue(headers,'Content-Length'); if(cl2){var n2=parseInt(cl2,10);if(!isNaN(n2))ridRowData[rid].size=n2;}
    } else if (type === 'RES_BODY' && body != null) {
      var resEnc = getHeaderValue(ridRowData[rid].resHeaders || [], 'Content-Encoding');
      if (resEnc && resEnc.toLowerCase().indexOf('gzip') >= 0) {
        decompressGzip(body).then(function(decompressed) {
          ridRowData[rid].resBody = decompressed;
          if (ridRowData[rid].size == null && Array.isArray(decompressed)) ridRowData[rid].size = decompressed.length;
          var disp = buildDisplay(ridRowData[rid]); var row = findRow(rid); if (row) updateRow(row, disp);
          if (rid === selectedRid) populateDetail(rid);
        });
        return;
      }
      ridRowData[rid].resBody = body;
      if (ridRowData[rid].size == null) {
        if (typeof body==='string') { try{ridRowData[rid].size=atob(body).length;}catch(x){ridRowData[rid].size=body.length;} }
        else if (Array.isArray(body)) ridRowData[rid].size=body.length;
      }
    }
    var disp = buildDisplay(ridRowData[rid]);
    var row = findRow(rid);
    if (row) updateRow(row, disp); else addRow(rid, disp);
    if (rid === selectedRid) populateDetail(rid);
  }

  /* ── Body decode helpers ────────────────────────────────── */
  function decodeBody(body) {
    if (body == null) return null;
    if (typeof body === 'string') {
      try { var b=atob(body), arr=new Uint8Array(b.length); for(var i=0;i<b.length;i++)arr[i]=b.charCodeAt(i); return new TextDecoder().decode(arr); }
      catch(e) { return body; }
    }
    if (Array.isArray(body)) return new TextDecoder().decode(new Uint8Array(body));
    return String(body);
  }
  function bodyToBase64(body) {
    if (body == null) return null;
    if (typeof body === 'string') return body;
    if (Array.isArray(body)) {
      try { var arr=new Uint8Array(body),s=''; for(var i=0;i<arr.length;i++)s+=String.fromCharCode(arr[i]); return btoa(s); }
      catch(e) { return null; }
    }
    return null;
  }
  function bodyToBytes(body) {
    if (body == null) return null;
    if (typeof body === 'string') {
      try { var b=atob(body),a=new Uint8Array(b.length); for(var i=0;i<b.length;i++)a[i]=b.charCodeAt(i); return a; }
      catch(e) { return null; }
    }
    return Array.isArray(body) ? new Uint8Array(body) : null;
  }
  function decompressGzip(body) {
    var bytes = bodyToBytes(body);
    if (!bytes || !bytes.length || typeof DecompressionStream === 'undefined') return Promise.resolve(body);
    try {
      var ds = new DecompressionStream('gzip');
      var writer = ds.writable.getWriter();
      var reader = ds.readable.getReader();
      writer.write(bytes);
      writer.close();
      var chunks = [], totalLen = 0;
      function pump() {
        return reader.read().then(function(r) {
          if (r.done) {
            var out = new Uint8Array(totalLen), off = 0;
            for (var i = 0; i < chunks.length; i++) { out.set(chunks[i], off); off += chunks[i].length; }
            return Array.from(out);
          }
          chunks.push(r.value); totalLen += r.value.length; return pump();
        });
      }
      return pump().catch(function() { return body; });
    } catch(e) { return Promise.resolve(body); }
  }
  var IMG_EXT = {jpg:'image/jpeg',jpeg:'image/jpeg',png:'image/png',gif:'image/gif',webp:'image/webp',bmp:'image/bmp',svg:'image/svg+xml',ico:'image/x-icon'};
  function detectImageMime(bytes) {
    if (!bytes || bytes.length < 4) return null;
    if (bytes[0]===0x89&&bytes[1]===0x50&&bytes[2]===0x4E&&bytes[3]===0x47) return 'image/png';
    if (bytes[0]===0xFF&&bytes[1]===0xD8&&bytes[2]===0xFF) return 'image/jpeg';
    if (bytes[0]===0x47&&bytes[1]===0x49&&bytes[2]===0x46&&bytes[3]===0x38) return 'image/gif';
    if (bytes[0]===0x42&&bytes[1]===0x4D) return 'image/bmp';
    if (bytes.length>=12&&bytes[0]===0x52&&bytes[1]===0x49&&bytes[2]===0x46&&bytes[3]===0x46&&bytes[8]===0x57&&bytes[9]===0x45&&bytes[10]===0x42&&bytes[11]===0x50) return 'image/webp';
    return null;
  }
  function isImageResp(h, body) {
    var ct = getHeaderValue(h,'Content-Type'); if(ct&&ct.toLowerCase().indexOf('image/')===0) return true;
    var cd = getHeaderValue(h,'Content-Disposition');
    if(cd){var m=cd.match(/filename\s*=\s*["']?([^"'\s]+)["']?/i);if(m&&IMG_EXT[(m[1].split('.').pop()||'').toLowerCase()]) return true;}
    var b=bodyToBytes(body); return b && !!detectImageMime(b);
  }
  function getImageMime(h, body) {
    var ct=getHeaderValue(h,'Content-Type'); if(ct&&ct.toLowerCase().indexOf('image/')===0) return ct.split(';')[0].trim();
    var cd=getHeaderValue(h,'Content-Disposition');
    if(cd){var m=cd.match(/filename\s*=\s*["']?([^"'\s]+)["']?/i);if(m) return IMG_EXT[(m[1].split('.').pop()||'').toLowerCase()]||'image/jpeg';}
    var b=bodyToBytes(body); return detectImageMime(b)||'image/jpeg';
  }

  /* ── Cookie helpers ─────────────────────────────────────── */
  function parseCookies(str) {
    if (!str) return [];
    return str.split(';').map(function(p) {
      var eq=p.indexOf('='), name=eq>=0?p.substring(0,eq).trim():p.trim(), val=eq>=0?p.substring(eq+1).trim():'';
      return name ? {name:name,value:val} : null;
    }).filter(Boolean);
  }
  var MAX_CNAME = 32;
  function scFirstName(line) {
    var semi=line.indexOf(';'), first=semi>=0?line.substring(0,semi):line, eq=first.indexOf('=');
    return (eq>=0?first.substring(0,eq):first).trim();
  }
  function scLinePadded(line, maxLen) {
    var semi=line.indexOf(';'), first=semi>=0?line.substring(0,semi).trim():line.trim(), rest=semi>=0?line.substring(semi):'';
    var eq=first.indexOf('='), name=eq>=0?first.substring(0,eq).trim():first, val=eq>=0?first.substring(eq+1):'';
    return '  '+(name||'').padEnd(maxLen,' ')+' : '+val+rest;
  }

  /* ── Body format helpers ────────────────────────────────── */
  function tryJson(str) { try{return JSON.stringify(JSON.parse(str),null,2);}catch(e){return str;} }
  function parseUrlEncoded(str) {
    if (!str||!str.trim()) return null;
    return str.split('&').map(function(p) {
      var eq=p.indexOf('='), n=eq>=0?p.substring(0,eq):p, v=eq>=0?p.substring(eq+1):'';
      try{n=decodeURIComponent(n.replace(/\+/g,' '));}catch(e){}
      try{v=decodeURIComponent(v.replace(/\+/g,' '));}catch(e){}
      return {name:n,value:v};
    }).filter(function(x){return x.name;});
  }
  function parseQS(path) { var i=path&&path.indexOf('?'); return (i>=0)?parseUrlEncoded(path.substring(i+1)):null; }
  function fmtQS(path) {
    var ps=parseQS(path); if(!ps||!ps.length) return null;
    return [MSG['monitor.detail.query.string']].concat(ps.map(function(p){return '  '+p.name+': '+p.value;})).join('\n');
  }
  function fmtForm(body) {
    var ps=parseUrlEncoded(body); if(!ps||!ps.length) return null;
    return [MSG['monitor.detail.form.data']].concat(ps.map(function(p){return '  '+p.name+': '+p.value;})).join('\n');
  }
  function isFormEnc(h) { var ct=getHeaderValue(h,'Content-Type'); return ct&&ct.toLowerCase().indexOf('application/x-www-form-urlencoded')>=0; }

  /* ── WebSocket panel ────────────────────────────────────── */
  var OPNAMES={0:'continuation',1:'text',2:'binary',8:'close',9:'ping',10:'pong'};
  function fmtWsPayload(body) {
    if (!body) return '';
    var str=decodeBody(body);
    if (str&&/^[\x20-\x7E\r\n\t]*$/.test(str)) return str;
    var b=bodyToBytes(body); if(!b||!b.length) return '(empty)';
    var h=''; for(var i=0;i<Math.min(b.length,64);i++) h+=('0'+b[i].toString(16)).slice(-2)+' ';
    return b.length>64?h+'...':h.trim();
  }
  function renderWsFrames(frames) {
    if (!frames||!frames.length) return MSG['monitor.detail.ws.empty'];
    return frames.map(function(f) {
      var dir=f.direction==='REQ'?'Client →':'← Server', op=OPNAMES[f.opcode]||('0x'+f.opcode);
      return '<div class="ws-frame"><span class="ws-frame-meta">['+formatStart(f.timestamp)+'] '+dir+' '+op+'</span><pre class="ws-frame-payload">'+escHtml(fmtWsPayload(f.body))+'</pre></div>';
    }).join('');
  }
  function updateWsPanel(rid) {
    var p=document.getElementById('detail-websocket'); if(!p) return;
    if (!rid||!ridRowData[rid]) { p.innerHTML=MSG['monitor.detail.empty']; p.classList.add('is-empty'); return; }
    p.innerHTML=renderWsFrames(ridRowData[rid].wsFrames||[]);
    p.classList.remove('is-empty');
    p.scrollTop=p.scrollHeight;
  }

  /* ── Render label + data lines, escaping data but styling labels ── */
  function sectionLabel(text) { return {label:true, text:text}; }
  function renderLabeledLines(panel, items) {
    panel.innerHTML = items.map(function(it) {
      if (typeof it !== 'object') it = {text:it};
      var text = escHtml(it.text);
      return it.label ? '<span class="monitor-section-label">'+text+'</span>' : text;
    }).join('\n');
  }

  /* ── Populate detail panels ─────────────────────────────── */
  function populateDetail(rid) {
    selectedRid = rid;
    var empty = MSG['monitor.detail.empty'];
    var pHeader=document.getElementById('detail-header'), pCookie=document.getElementById('detail-cookie'),
        pReq=document.getElementById('detail-request'), pRes=document.getElementById('detail-response'),
        pWs=document.getElementById('detail-websocket');

    if (!rid || !ridRowData[rid]) {
      [pHeader,pCookie,pReq,pRes,pWs].forEach(function(p){if(p){p.textContent=empty;p.classList.add('is-empty');}});
      return;
    }
    var d=ridRowData[rid], reqH=d.reqHeaders||[], resH=d.resHeaders||[];

    // Header
    var hl=[
      sectionLabel(MSG['monitor.detail.section.general']),
      '  '+MSG['monitor.detail.label.request.id']+': '+rid,
      '  '+MSG['monitor.detail.label.request.url']+': '+(d.path&&d.path.indexOf('://')>=0?d.path:'https://'+(d.host||'localhost')+d.path),
      '  '+MSG['monitor.detail.label.request.method']+': '+(d.method||'GET'),
      '  '+MSG['monitor.detail.label.status.code']+': '+(d.code||'-'),
      '',
      sectionLabel(MSG['monitor.detail.request.headers'])
    ];
    reqH.forEach(function(l){if(typeof l==='string')hl.push('  '+l);});
    hl.push('',sectionLabel(MSG['monitor.detail.response.headers']));
    resH.forEach(function(l){if(typeof l==='string')hl.push('  '+l);});
    renderLabeledLines(pHeader, hl);
    pHeader.classList.remove('is-empty');

    // Cookie
    var cl=[], cookies=parseCookies(getHeaderValue(reqH,'Cookie')).filter(function(c){return c.name.length<=MAX_CNAME;});
    cookies.sort(function(a,b){return a.name.localeCompare(b.name,undefined,{sensitivity:'base'});});
    var scRaw=getAllHeaderValues(resH,'Set-Cookie').filter(function(l){return scFirstName(l).length<=MAX_CNAME;});
    scRaw.sort(function(a,b){return scFirstName(a).localeCompare(scFirstName(b),undefined,{sensitivity:'base'});});
    var maxCN=Math.max(0,Math.max.apply(null,cookies.map(function(c){return c.name.length;}).concat(scRaw.map(function(l){return scFirstName(l).length;}))));
    if(cookies.length){cl.push(sectionLabel(MSG['monitor.detail.request.cookies']));cookies.forEach(function(c){cl.push('  '+c.name.padEnd(maxCN,' ')+' : '+c.value);});}
    if(scRaw.length){if(cl.length)cl.push('');cl.push(sectionLabel(MSG['monitor.detail.response.set.cookie']));scRaw.forEach(function(l){cl.push(scLinePadded(l,maxCN));});}
    var hasCookies = cl.length>0;
    if (hasCookies) renderLabeledLines(pCookie, cl);
    else pCookie.textContent = MSG['monitor.detail.no.cookies'];
    pCookie.classList.toggle('is-empty', !hasCookies);

    // Request
    var reqBody=decodeBody(d.reqBody), reqText=null;
    if(reqBody){reqText=(isFormEnc(reqH)||reqBody.indexOf('&')>=0&&reqBody.indexOf('=')>=0)?fmtForm(reqBody)||reqBody:tryJson(reqBody);}
    var qs=fmtQS(d.path);
    var hasReqContent = !!(reqText||qs);
    reqText = reqText||qs||MSG['monitor.detail.no.payload'];
    pReq.textContent=reqText;
    pReq.classList.toggle('is-empty', !hasReqContent);

    // Response
    if(isImageResp(resH,d.resBody)&&d.resBody){
      var b64=bodyToBase64(d.resBody);
      pRes.innerHTML=b64?'<img src="data:'+getImageMime(resH,d.resBody)+';base64,'+b64+'" alt="'+escHtml(MSG['monitor.detail.image.alt'])+'" style="max-width:100%;height:auto;">':MSG['monitor.detail.image.decode.failed'];
      pRes.classList.toggle('is-empty', !b64);
    } else {
      var rb=decodeBody(d.resBody); pRes.textContent=rb?tryJson(rb):MSG['monitor.detail.no.response'];
      pRes.classList.toggle('is-empty', !rb);
    }

    // WebSocket
    var wsFrames=d.wsFrames||[];
    pWs.innerHTML=renderWsFrames(wsFrames);
    pWs.classList.toggle('is-empty', wsFrames.length===0);
  }

  /* ── SSE ────────────────────────────────────────────────── */
  var es = new EventSource('/api/proxy/monitor/event');
  es.onmessage = function(e) {
    appendEventLog(e.data);
    try { var d=JSON.parse(e.data); if(d.rid) upsertRow(d); } catch(err) { console.warn('Monitor SSE parse error:', err); }
  };
  es.onerror = function() { console.warn('Monitor SSE connection error'); };

  /* ── Splitter drag ──────────────────────────────────────── */
  (function() {
    var splitter = document.getElementById('monitor-splitter');
    var logPane  = document.getElementById('monitor-log-list');
    var navbar   = document.querySelector('.oe-navbar');

    splitter.addEventListener('mousedown', function(e) {
      e.preventDefault();
      splitter.classList.add('dragging');
      document.body.style.cursor = 'ns-resize';
      document.body.style.userSelect = 'none';

      function onMove(e) {
        var top = (navbar ? navbar.offsetHeight : 56);
        var h = e.clientY - top;
        h = Math.max(80, Math.min(h, window.innerHeight - top - 150));
        logPane.style.flex = '0 0 ' + h + 'px';
        logPane.style.minHeight = h + 'px';
      }
      function onUp() {
        splitter.classList.remove('dragging');
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  })();

  // ── Panel toggle ───────────────────────────────────────────
  initWidthToggle(document.getElementById('monitorApp'), document.getElementById('btnToggleWidth'));

  {% if not proxyActive %}
  new bootstrap.Modal(document.getElementById('modalProxyInactive')).show();
  {% endif %}
})();
</script>
{% endblock %}
