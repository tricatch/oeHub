<!DOCTYPE html>
<html lang="{{ currentLocale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}oeHub{% endblock %}</title>
  <link rel="icon" type="image/svg+xml" href="/icon/oe_logo_favicon.svg">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/brand.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/icon.css">
  {% block styles %}{% endblock %}
</head>
<body>
<script nonce="{{ cspNonce }}">if (localStorage.getItem('oeWidthExpanded') === 'true') document.body.classList.add('oe-expanded');</script>

<nav class="navbar navbar-expand oe-navbar" data-bs-theme="light">
  <div class="container-fluid px-1">

    <a class="navbar-brand oe-navbar-brand" href="/">
      <img src="/icon/oe_logo_nav.svg" alt="oeHub" width="28" height="28">
    </a>

      <div class="oe-nav-items">
        <a class="oe-nav-item" href="/oehub/hosts" id="navItem-hosts">oeHosts</a>
        {% if not workspaceMode %}
        <span class="oe-nav-item-sep">|</span>
        <a class="oe-nav-item" href="/oehub/proxy" id="navItem-proxy">oeProxy</a>
        {% endif %}
      </div>
      <script nonce="{{ cspNonce }}">
        (function() {
          var path = location.pathname;
          var activeId = path.startsWith('/oehub/hosts') ? 'navItem-hosts'
                       : path.startsWith('/oehub/proxy') ? 'navItem-proxy'
                       : null;
          if (activeId) document.getElementById(activeId).classList.add('active');
        })();
      </script>

      {% block navActions %}{% endblock %}

      <div class="navbar-nav ms-auto d-flex flex-row align-items-center me-2">
        {% if user is not null %}
        <div class="nav-item dropdown">
          <a href="#" class="nav-link d-flex align-items-center gap-2 pe-0"
             data-bs-toggle="dropdown" aria-expanded="false">
            <span class="oe-avatar">
              {% if user.role == 'adm' %}
              <span class="oe-icon oe-icon-admin" style="width:16px;height:16px"></span>
              {% else %}
              <span class="oe-icon oe-icon-user" style="width:16px;height:16px"></span>
              {% endif %}
            </span>
            <span>{{ user.userId }}</span>
            <span class="oe-icon oe-icon-chevron-down opacity-50" style="width:14px;height:14px"></span>
          </a>
          <div class="dropdown-menu dropdown-menu-end oe-user-dropdown">
            <a href="/oehub/my/info" class="dropdown-item">{{ msg['nav.my.info'] }}</a>
            <a href="#" class="dropdown-item" id="navBtnChangePassword">{{ msg['nav.change.password'] }}</a>
            {% if workspaceMode %}
            <a href="#" class="dropdown-item" id="navBtnReissueRecovery">{{ msg['nav.reissue.recovery'] }}</a>
            {% endif %}
            {% if user.role == 'adm' %}
            <a href="/adm/settings" class="dropdown-item">{{ msg['nav.settings'] }}</a>
            {% if not workspaceMode %}
            <a href="/wsa/users" class="dropdown-item">{{ msg['nav.admin.users'] }}</a>
            <a href="/wsa/audit-log" class="dropdown-item">{{ msg['nav.admin.audit.log'] }}</a>
            {% endif %}
            {% if workspaceMode %}
            <a href="/adm/workspaces" class="dropdown-item">{{ msg['nav.admin.workspaces'] }}</a>
            {% endif %}
            <a href="/adm/h2" target="_blank" class="dropdown-item">{{ msg['nav.h2console'] }}</a>
            {% else %}
            <a href="/oehub/my/setting" class="dropdown-item">{{ msg['nav.settings'] }}</a>
            {% if user.role == 'wsa' %}
            <a href="/wsa/users" class="dropdown-item">{{ msg['nav.admin.users'] }}</a>
            <a href="/wsa/audit-log" class="dropdown-item">{{ msg['nav.admin.audit.log'] }}</a>
            {% endif %}
            {% endif %}
            <a href="/oehub/licenses" class="dropdown-item">{{ msg['nav.licenses'] }}</a>
            <hr class="dropdown-divider">
            <a href="#" class="dropdown-item" id="navBtnBackup">{{ msg['nav.backup'] }}</a>
            <a href="#" class="dropdown-item" id="navBtnRestore">{{ msg['nav.restore'] }}</a>
            <hr class="dropdown-divider">
            <button type="button" class="dropdown-item d-flex align-items-center gap-2" id="btnToggleWidth">
              <span class="oe-icon oe-icon-expand icon-width-expand opacity-50" style="width:13px;height:13px;flex-shrink:0"></span>
              <span class="oe-icon oe-icon-collapse icon-width-collapse opacity-50" style="width:13px;height:13px;flex-shrink:0;display:none"></span>
              <span class="icon-width-expand">{{ msg['ui.expand'] }}</span>
              <span class="icon-width-collapse" style="display:none">{{ msg['ui.collapse'] }}</span>
            </button>
            <hr class="dropdown-divider">
            <div class="px-3 py-1 d-flex align-items-center gap-2">
              <span class="oe-icon oe-icon-lang opacity-50" style="width:13px;height:13px;flex-shrink:0"></span>
              <select class="oe-lang-select" id="langSelect">
                <option value="en"{% if currentLocale == 'en' %} selected{% endif %}>{{ msg['lang.english'] }}</option>
                <option value="ko"{% if currentLocale == 'ko' %} selected{% endif %}>{{ msg['lang.korean'] }}</option>
              </select>
            </div>
            <hr class="dropdown-divider">
            <a href="/logout" class="dropdown-item text-danger" id="navLogoutLink">
              <span class="oe-icon oe-icon-logout me-2" style="width:14px;height:14px"></span>
              {{ msg['nav.signout'] }}
            </a>
          </div>
        </div>
        {% endif %}
      </div>

  </div>
</nav>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script nonce="{{ cspNonce }}">window.MSG = {{ msgJson | raw }};</script>
<script nonce="{{ cspNonce }}">window.OE_WORKSPACE_MODE = {{ workspaceMode ? 'true' : 'false' }};</script>
<script src="/js/util.js"></script>
<script src="/js/crypto.js"></script>
<script src="/js/auth-keys.js"></script>
<script src="/js/session-keys.js"></script>
<script src="/js/content-crypto.js"></script>
<script src="/js/recovery-code-modal.js"></script>
<script nonce="{{ cspNonce }}">
  // Cached private/workspace keys (e2eEncryption design doc §3) are only meaningful for the
  // session that unwrapped them - clear them on the way out so the next login starts clean.
  (function () {
    var link = document.getElementById('navLogoutLink');
    if (!link) return;
    link.addEventListener('click', function (e) {
      e.preventDefault();
      OE_SESSION_KEYS.clearAll().catch(function () {}).then(function () {
        location.href = '/logout';
      });
    });
  })();
</script>

<main class="{% block pageClass %}{% endblock %}">
  {% block content %}{% endblock %}
</main>

<div class="oe-toast" id="toast">
  <span class="oe-icon oe-icon-success" style="width:21px;height:21px"></span>
  <span class="oe-toast-msg"></span>
</div>

<!-- Restore modal -->
<div class="modal fade" id="restoreModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header"><h5 class="modal-title">{{ msg['nav.restore'] }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="file" class="form-control form-control-sm mb-2" id="restoreFile" accept=".json">
        <div class="form-check small"><input type="radio" class="form-check-input" name="restoreMode" id="restoreModeReplace" value="replace" checked><label class="form-check-label" for="restoreModeReplace">{{ msg['nav.restore.mode.replace'] }}</label></div>
        <div class="form-check small"><input type="radio" class="form-check-input" name="restoreMode" id="restoreModeMerge" value="merge"><label class="form-check-label" for="restoreModeMerge">{{ msg['nav.restore.mode.merge'] }}</label></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="oe-modal-btn oe-modal-btn-plain" data-bs-dismiss="modal">{{ msg['btn.cancel'] }}</button>
        <button type="button" class="oe-modal-btn" id="btnRestoreConfirm">{{ msg['btn.restore'] }}</button>
      </div>
    </div>
  </div>
</div>

<!-- Change password modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header"><h5 class="modal-title">{{ msg['nav.change.password'] }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-2">
          <label class="form-label small mb-1" for="cpCurrentPassword">{{ msg['change.password.current'] }}</label>
          <input type="password" class="form-control form-control-sm" id="cpCurrentPassword" autocomplete="current-password">
        </div>
        <div class="mb-2">
          <label class="form-label small mb-1" for="cpNewPassword">{{ msg['change.password.new'] }}</label>
          <input type="password" class="form-control form-control-sm" id="cpNewPassword" autocomplete="new-password">
        </div>
        <div class="mb-1">
          <label class="form-label small mb-1" for="cpConfirmPassword">{{ msg['change.password.confirm'] }}</label>
          <input type="password" class="form-control form-control-sm" id="cpConfirmPassword" autocomplete="new-password">
        </div>
        <div class="small text-danger d-none" id="cpError"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="oe-modal-btn oe-modal-btn-plain" data-bs-dismiss="modal">{{ msg['btn.cancel'] }}</button>
        <button type="button" class="oe-modal-btn" id="btnChangePasswordConfirm">{{ msg['btn.confirm'] }}</button>
      </div>
    </div>
  </div>
</div>

<!-- Reissue recovery code - password re-confirmation gate. The reissue itself re-wraps this
     session's already-cached private key (no password needed for that crypto step), so without
     this gate a hijacked session cookie alone could silently mint a persistent recovery code even
     though the attacker never knew the password. -->
<div class="modal fade" id="reissueConfirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header"><h5 class="modal-title">{{ msg['nav.reissue.recovery'] }}</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <p class="small text-muted mb-2">{{ msg['recovery.reissue.confirm.desc'] }}</p>
        <div class="mb-1">
          <label class="form-label small mb-1" for="rrCurrentPassword">{{ msg['change.password.current'] }}</label>
          <input type="password" class="form-control form-control-sm" id="rrCurrentPassword" autocomplete="current-password">
        </div>
        <div class="small text-danger d-none" id="rrError"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="oe-modal-btn oe-modal-btn-plain" data-bs-dismiss="modal">{{ msg['btn.cancel'] }}</button>
        <button type="button" class="oe-modal-btn" id="btnReissueConfirm">{{ msg['btn.confirm'] }}</button>
      </div>
    </div>
  </div>
</div>

<!-- Reissue recovery code modal (e2eEncryption design doc §3/§9 "재발급") -->
<div class="modal fade" id="reissueRecoveryModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content oe-modal">
      <div class="modal-header oe-modal-header"><h5 class="modal-title">{{ msg['auth.recovery.title'] }}</h5></div>
      <div class="modal-body">
        <div class="alert alert-warning py-2 small mb-3">{{ msg['auth.recovery.warning'] }}</div>
        <div class="alert alert-info py-2 small mb-3">{{ msg['recovery.reissue.invalidates.old'] }}</div>
        <div class="input-group mb-2">
          <input type="text" class="form-control setup-mono" id="reissueRecoveryCodeValue" readonly>
          <button type="button" class="btn btn-sm btn-oe-secondary" id="btnCopyReissuedRecoveryCode" title="{{ msg['ui.copy.clipboard'] }}">
            <span class="oe-icon oe-icon-copy" style="width:13px;height:13px"></span>
          </button>
        </div>
        <button type="button" class="btn btn-sm btn-oe-secondary" id="btnDownloadReissuedRecoveryCode">
          <span class="oe-icon oe-icon-download" style="width:13px;height:13px"></span>
          {{ msg['auth.recovery.download'] }}
        </button>
      </div>
      <div class="modal-footer">
        <button type="button" class="oe-modal-btn oe-modal-btn-plain justify-content-center" id="btnReissueRecoveryContinue">{{ msg['auth.recovery.continue'] }}</button>
      </div>
    </div>
  </div>
</div>
<script nonce="{{ cspNonce }}">
  document.getElementById('langSelect').addEventListener('change', function() {
    document.cookie = 'oe_lang=' + this.value + '; path=/; max-age=31536000';
    location.reload();
  });

  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') e.preventDefault();
  });

  document.getElementById('navBtnBackup')?.addEventListener('click', async function(e) {
    e.preventDefault();
    var res = await fetch('/api/user/backup');
    if (!res.ok) { showToast(MSG['toast.backup.failed']); return; }
    var blob = await res.blob();
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = (res.headers.get('Content-Disposition') || '').split('filename=')[1]?.replace(/"/g, '') || 'oehub-backup.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  });

  document.getElementById('navBtnRestore')?.addEventListener('click', function(e) {
    e.preventDefault();
    document.getElementById('restoreFile').value = '';
    new bootstrap.Modal(document.getElementById('restoreModal')).show();
  });

  document.getElementById('btnRestoreConfirm').addEventListener('click', async function() {
    var file = document.getElementById('restoreFile').files[0];
    if (!file) return;
    var merge = document.querySelector('input[name=restoreMode]:checked').value === 'merge';
    var text = await file.text();
    var res = await fetch('/api/user/restore?merge=' + merge, {
      method: 'POST', headers: {'Content-Type': 'application/json'}, body: text
    });
    if (res.ok) {
      bootstrap.Modal.getInstance(document.getElementById('restoreModal')).hide();
      location.reload();
    } else {
      showToast(MSG['toast.restore.failed']);
    }
  });

  document.getElementById('navBtnChangePassword')?.addEventListener('click', function(e) {
    e.preventDefault();
    document.getElementById('cpCurrentPassword').value = '';
    document.getElementById('cpNewPassword').value = '';
    document.getElementById('cpConfirmPassword').value = '';
    document.getElementById('cpError').classList.add('d-none');
    new bootstrap.Modal(document.getElementById('changePasswordModal')).show();
  });

  function showChangePasswordError(text) {
    var errEl = document.getElementById('cpError');
    errEl.textContent = text;
    errEl.classList.remove('d-none');
  }

  document.getElementById('btnChangePasswordConfirm').addEventListener('click', async function() {
    var current = document.getElementById('cpCurrentPassword').value;
    var next    = document.getElementById('cpNewPassword').value;
    var confirmVal = document.getElementById('cpConfirmPassword').value;

    if (!next) { showChangePasswordError(MSG['change.password.error.required']); return; }
    if (next.length < 8) { showChangePasswordError(MSG['change.password.error.too.short']); return; }
    if (next !== confirmVal) { showChangePasswordError(MSG['change.password.error.mismatch']); return; }

    // wrapped_private_key must be re-wrapped for the new password in the same request - the old
    // wrap becomes unusable the moment the password changes (e2eEncryption design doc §3). The
    // already-unwrapped private key comes from this session's own cache (from login), not by
    // re-deriving from currentPassword - simpler, and works the same way regardless of how the
    // key got into the cache.
    var newWrappedPrivateKey;
    // What the server receives for the passwords: the typed values in self-hosted, but in
    // workspace mode only authKeys derived from them (auth-keys.js) - the server never sees a
    // password, so the "confirm" value is the new authKey again (equality was checked above).
    var sentCurrent = current, sentNext = next, sentConfirm = confirmVal;
    if (!window.OE_WORKSPACE_MODE) {
      // self-hosted never had a real wrap to begin with (dummy identity crypto - e2eEncryption
      // design doc §1), so there is nothing to re-wrap and no session-cached key to require.
      newWrappedPrivateKey = 'self-hosted';
    } else {
      var privateKey = await OE_SESSION_KEYS.loadPrivateKey().catch(function () { return null; });
      if (!privateKey) {
        showChangePasswordError(MSG['change.password.error.no.cached.key']);
        return;
      }
      try {
        sentCurrent = await OE_AUTH.currentAuthKey(current);
        var newKeys = await OE_AUTH.keysForNewPassword(next);
        var wrap = await OE_CRYPTO.wrapPrivateKey(privateKey, newKeys.kek);
        newWrappedPrivateKey = JSON.stringify({ salt: newKeys.salt, iv: wrap.iv, wrapped: wrap.wrapped });
        sentNext = newKeys.authKey;
        sentConfirm = newKeys.authKey;
      } catch (err) {
        console.error('Key derivation failed:', err);
        showChangePasswordError(MSG['change.password.error.failed']);
        return;
      }
    }

    var res = await fetch('/api/user/change-password', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        currentPassword: sentCurrent, newPassword: sentNext, confirmPassword: sentConfirm,
        newWrappedPrivateKey: newWrappedPrivateKey
      })
    });
    if (res.ok) {
      bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
      showToast(MSG['toast.password.changed']);
    } else {
      var data = await res.json().catch(function() { return {}; });
      if (data.error === 'too_many_attempts') {
        // Same shared attempt budget as recovery-code reissue below - the server already killed
        // every session for this account (token_version bump).
        alert(MSG['password.confirm.too.many.attempts']);
        location.href = '/logout';
        return;
      }
      if (data.error === 'current_password_invalid') {
        var cpMsg = MSG['change.password.error.current.invalid'];
        if (typeof data.remainingAttempts === 'number') {
          cpMsg += ' ' + MSG['password.confirm.attempts.remaining'].replace('{0}', data.remainingAttempts);
        }
        showChangePasswordError(cpMsg);
        return;
      }
      var key = data.error === 'password_too_short' ? 'change.password.error.too.short'
              : data.error === 'password_mismatch'   ? 'change.password.error.mismatch'
              : 'change.password.error.failed';
      showChangePasswordError(MSG[key]);
    }
  });

  // Reissue recovery code (e2eEncryption design doc §3/§9 "재발급"): re-wraps the SAME already-
  // unwrapped private key (from this session's cache, exactly like change-password above) under
  // a freshly-generated recovery code - old code silently stops working the moment the new one
  // is saved, since wrapped_private_key_recovery is a single column, not a list.
  //
  // The crypto itself needs no password (the private key is already unwrapped in this session's
  // cache) - but that also means a hijacked session cookie alone, with no knowledge of the actual
  // password, could otherwise mint itself a lasting recovery code. So this is gated behind a
  // current-password re-confirmation, verified server-side, before the reissue call ever runs.
  var pendingReissuedRecoveryCode = '';
  document.getElementById('navBtnReissueRecovery')?.addEventListener('click', function(e) {
    e.preventDefault();
    document.getElementById('rrCurrentPassword').value = '';
    document.getElementById('rrError').classList.add('d-none');
    new bootstrap.Modal(document.getElementById('reissueConfirmModal')).show();
  });

  function showReissueConfirmError(text) {
    var errEl = document.getElementById('rrError');
    errEl.textContent = text;
    errEl.classList.remove('d-none');
  }

  document.getElementById('btnReissueConfirm').addEventListener('click', async function() {
    var currentPassword = document.getElementById('rrCurrentPassword').value;

    var privateKey = await OE_SESSION_KEYS.loadPrivateKey().catch(function () { return null; });
    if (!privateKey) { showReissueConfirmError(MSG['change.password.error.no.cached.key']); return; }

    // Reissue is workspace-mode only; the server verifies the authKey derived from the password,
    // never the password itself (auth-keys.js).
    var currentAuthKey;
    try {
      currentAuthKey = await OE_AUTH.currentAuthKey(currentPassword);
    } catch (err) {
      console.error('Key derivation failed:', err);
      showReissueConfirmError(MSG['toast.recovery.reissue.failed']);
      return;
    }

    var recoveryBytes = OE_CRYPTO.generateRecoveryKeyBytes();
    var recoveryKek = await OE_CRYPTO.importRecoveryKeyAsAesGcm(recoveryBytes);
    var recoveryWrap = await OE_CRYPTO.wrapPrivateKey(privateKey, recoveryKek);
    var wrappedPrivateKeyRecovery = JSON.stringify({ iv: recoveryWrap.iv, wrapped: recoveryWrap.wrapped });
    var recoveryVerifier = await OE_CRYPTO.deriveRecoveryVerifier(recoveryBytes);
    pendingReissuedRecoveryCode = OE_CRYPTO.formatRecoveryDisplayCode(recoveryBytes);

    var res = await fetch('/api/user/recovery-key', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        currentPassword: currentAuthKey,
        wrappedPrivateKeyRecovery: wrappedPrivateKeyRecovery, recoveryVerifier: recoveryVerifier
      })
    });
    if (!res.ok) {
      var data = await res.json().catch(function() { return {}; });
      if (data.error === 'too_many_attempts') {
        // Same shared attempt budget as change-password above - the server already killed every
        // session for this account (token_version bump). An alert (rather than the usual inline
        // error) makes sure this registers before the redirect yanks the page away.
        alert(MSG['password.confirm.too.many.attempts']);
        location.href = '/logout';
        return;
      }
      if (data.error === 'current_password_invalid') {
        var msg = MSG['change.password.error.current.invalid'];
        if (typeof data.remainingAttempts === 'number') {
          msg += ' ' + MSG['password.confirm.attempts.remaining'].replace('{0}', data.remainingAttempts);
        }
        showReissueConfirmError(msg);
        return;
      }
      showReissueConfirmError(MSG['toast.recovery.reissue.failed']);
      return;
    }

    bootstrap.Modal.getInstance(document.getElementById('reissueConfirmModal')).hide();
    document.getElementById('reissueRecoveryCodeValue').value = pendingReissuedRecoveryCode;
    new bootstrap.Modal(document.getElementById('reissueRecoveryModal')).show();
  });

  OE_RECOVERY_CODE_MODAL.bind({
    codeInputId: 'reissueRecoveryCodeValue', copyBtnId: 'btnCopyReissuedRecoveryCode', downloadBtnId: 'btnDownloadReissuedRecoveryCode',
    getCode: function () { return pendingReissuedRecoveryCode; }
  });

  document.getElementById('btnReissueRecoveryContinue').addEventListener('click', function () {
    bootstrap.Modal.getInstance(document.getElementById('reissueRecoveryModal')).hide();
    showToast(MSG['toast.recovery.reissued']);
  });
</script>
</body>
</html>
