<!DOCTYPE html>
<html lang="{{ currentLocale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ msg['auth.signin'] }}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/brand.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="bg-light">
<div class="d-flex min-vh-100 auth-wrap">
  <div class="container py-2">
    <div class="row justify-content-center">
      <div class="col-12 auth-col auth-col-narrow">

        <div class="text-center mb-3">
          <a href="/" class="text-decoration-none">
            <img src="/icon/oe_logo_original.svg" alt="oeHub Logo" class="oe-brand-logo">
            <h1 class="oe-brand-title">oeHub</h1>
          </a>
        </div>

        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h2 class="h5 text-center mb-4">{{ msg['auth.signin'] }}</h2>

            {% if error %}
            <div class="alert alert-danger py-2" role="alert">{{ msg[error] }}</div>
            {% endif %}
            {% if info %}
            <div class="alert alert-info py-2" role="alert">{{ msg[info] }}</div>
            {% endif %}
            <div class="alert alert-danger py-2 d-none" id="loginErrorBox" role="alert"></div>

            <form method="post" action="/login" autocomplete="off" id="loginForm">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="hidden" name="redirect" value="{{ redirect }}">

              <div class="mb-3">
                <label class="form-label">{{ msg['auth.userid'] }}</label>
                <input type="text" name="userId" class="form-control" autofocus>
              </div>

              <div class="mb-3">
                <label class="form-label">{{ msg['auth.password'] }}</label>
                <input type="password" name="password" class="form-control">
              </div>

              <div class="mb-3">
                <div class="form-check form-switch">
                  <input type="checkbox" name="rememberMe" class="form-check-input" id="rememberMe" role="switch" checked>
                  <label class="form-check-label" for="rememberMe">{{ msg['auth.remember.me'] }}</label>
                </div>
              </div>

              <div class="d-grid">
                <button type="submit" class="oe-modal-btn justify-content-center" id="btnLoginSubmit">{{ msg['auth.signin'] }}</button>
              </div>
            </form>
          </div>
        </div>

        <div class="text-center text-muted mt-3 small">
          {{ msg['auth.no.account'] }} <a href="/register">{{ msg['auth.signup'] }}</a>
        </div>
        <div class="text-center text-muted mt-1 small">
          <a href="/recover">{{ msg['auth.forgot.password'] }}</a>
        </div>

      </div>
    </div>
  </div>
</div>
<script>window.MSG = {{ msgJson | raw }};</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/crypto.js"></script>
<script src="/js/session-keys.js"></script>
<script>
(function () {
  var form = document.getElementById('loginForm');
  var submitBtn = document.getElementById('btnLoginSubmit');
  var submitBtnDefaultText = submitBtn.textContent;
  var errorBox = document.getElementById('loginErrorBox');

  function showError(message) {
    errorBox.textContent = message;
    errorBox.classList.remove('d-none');
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (submitBtn.disabled) return;
    errorBox.classList.add('d-none');
    submitBtn.disabled = true;

    var password = form.password.value;
    var body = new URLSearchParams();
    body.set('_csrf', form._csrf.value);
    body.set('redirect', form.redirect.value);
    body.set('userId', form.userId.value);
    body.set('password', password);
    body.set('rememberMe', form.rememberMe.checked ? 'on' : '');

    fetch('/login', { method: 'POST', body: body, redirect: 'follow' })
      .then(async function (response) {
        if (!response.redirected) {
          // processLogin re-renders login.pebble (200, no redirect) on any failure - pull the
          // error message out of that response rather than replacing the whole document.
          var doc = new DOMParser().parseFromString(await response.text(), 'text/html');
          var serverError = doc.querySelector('.alert-danger');
          showError(serverError ? serverError.textContent.trim() : MSG['auth.error.invalid.credentials']);
          submitBtn.disabled = false;
          return;
        }

        var landingUrl = response.url;
        try {
          await unwrapAndCacheSessionKeys(password);
        } catch (err) {
          // Login itself already succeeded server-side (the cookie is set) - a key-unwrap
          // failure here shouldn't strand the user on the login page, just leave content
          // encrypted for this session (pages that need it will re-prompt as appropriate, not
          // yet wired - e2eEncryption design doc §9 follow-up).
          console.error('Key unwrap failed after login:', err);
        }
        location.href = landingUrl;
      })
      .catch(function (err) {
        console.error('Login request failed:', err);
        submitBtn.disabled = false;
        showError(MSG['auth.error.invalid.credentials']);
      });
  });

  async function unwrapAndCacheSessionKeys(password) {
    var res = await fetch('/api/user/crypto-keys');
    if (!res.ok) return;
    var data = await res.json();
    if (!data.wrappedPrivateKey) return; // pre-e2e accounts with no keypair yet

    var record = JSON.parse(data.wrappedPrivateKey);
    var salt = new Uint8Array(OE_CRYPTO.base64ToBuf(record.salt));
    var passwordKek = await OE_CRYPTO.deriveKeyFromPassword(password, salt);
    var privateKey = await OE_CRYPTO.unwrapPrivateKey(record, passwordKek);
    await OE_SESSION_KEYS.savePrivateKey(privateKey);

    if (data.wrappedWsKey) {
      var wsKey = await OE_CRYPTO.unwrapWorkspaceKeyForUser(data.wrappedWsKey, privateKey);
      await OE_SESSION_KEYS.saveWorkspaceKey(wsKey);
    }
  }
})();
</script>
</body>
</html>
