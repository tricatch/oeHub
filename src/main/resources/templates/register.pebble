<!DOCTYPE html>
<html lang="{{ currentLocale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ msg['auth.create.account'] }}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/brand.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="bg-light">
<div class="d-flex min-vh-100 auth-wrap">
  <div class="container py-2">
    <div class="row justify-content-center">
      <div class="col-12 auth-col auth-col-narrow">

        <div class="text-center mb-3">
          <a href="/" class="text-decoration-none">
            <img src="/icon/oe_logo_original.svg" alt="oeHub Logo" class="oe-brand-logo">
            <h1 class="oe-brand-title">oeHub</h1>
          </a>
        </div>

        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h2 class="h5 text-center mb-4">{{ msg['auth.create.account'] }}</h2>

            {% if error %}
            <div class="alert alert-danger py-2" role="alert">{{ msg[error] }}</div>
            {% endif %}
            {% if inviteError %}
            <div class="alert alert-danger py-2" role="alert">{{ msg[inviteError] }}</div>
            {% endif %}

            <form method="post" action="/register" autocomplete="off" id="registerForm">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="hidden" name="publicKey" id="fldPublicKey">
              <input type="hidden" name="wrappedPrivateKey" id="fldWrappedPrivateKey">
              <input type="hidden" name="wrappedPrivateKeyRecovery" id="fldWrappedPrivateKeyRecovery">
              <input type="hidden" name="recoveryVerifier" id="fldRecoveryVerifier">
              {% if workspaceMode and not inviteCode %}
              <input type="hidden" name="founderWrappedWsKey" id="fldFounderWrappedWsKey">
              {% endif %}
              {% if workspaceMode and inviteCode %}
              <input type="hidden" name="inviteCode" value="{{ inviteCode }}">
              <div class="mb-3">
                <label class="form-label">{{ msg['auth.invite.joining'] }}</label>
                <input type="text" class="form-control" value="{{ inviteWsName }}" disabled>
              </div>
              {% elseif workspaceMode %}
              <div class="mb-3">
                <label class="form-label">{{ msg['auth.workspace.name'] }}</label>
                <input type="text" name="wsName" class="form-control" value="{{ wsName }}">
                <div class="form-text">{{ msg['auth.workspace.name.help'] }}</div>
              </div>
              {% endif %}
              <div class="mb-3">
                <label class="form-label">{{ msg['auth.userid'] }}</label>
                <input type="text" name="userId" class="form-control"
                       value="{{ userId }}" autofocus>
              </div>

              <div class="mb-3">
                <label class="form-label">{{ msg['auth.password'] }}</label>
                <input type="password" name="password" class="form-control">
              </div>

              <div class="mb-3">
                <label class="form-label">{{ msg['auth.confirm.password'] }}</label>
                <input type="password" name="confirmPassword" class="form-control">
              </div>

              <div class="d-grid">
                <button type="submit" class="oe-modal-btn justify-content-center" id="btnRegisterSubmit">{{ msg['auth.create.account'] }}</button>
              </div>
            </form>
          </div>
        </div>

        <div class="text-center text-muted mt-3 small">
          {{ msg['auth.have.account'] }} <a href="/login">{{ msg['auth.signin'] }}</a>
        </div>

      </div>
    </div>
  </div>
</div>

<div class="oe-toast" id="toast">
  <span class="oe-icon oe-icon-success" style="width:21px;height:21px"></span>
  <span class="oe-toast-msg"></span>
</div>

{% include "templates/_recovery-code-modal.pebble" %}

<script>window.MSG = {{ msgJson | raw }};</script>
<script>window.OE_WORKSPACE_MODE = {{ workspaceMode ? 'true' : 'false' }};</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/crypto.js"></script>
<script src="/js/util.js"></script>
<script src="/js/recovery-code-modal.js"></script>
<script>
(function () {
  var form = document.getElementById('registerForm');
  var submitBtn = document.getElementById('btnRegisterSubmit');
  var submitBtnDefaultText = submitBtn.textContent;
  var recoveryModalEl = document.getElementById('recoveryCodeModal');
  var recoveryModal = new bootstrap.Modal(recoveryModalEl);
  var pendingRecoveryCode = '';

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (submitBtn.disabled) return;

    var password = form.password.value;
    // Minimal client-side pre-check (mirrors AuthController's own rules) purely to avoid wasting
    // an RSA-2048 keygen on an obviously-invalid submission - the server remains the sole source
    // of truth and re-validates everything itself regardless.
    if (!password || password.length < 8 || password !== form.confirmPassword.value) {
      form.submit();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = MSG['auth.generating.keys'];

    generateIdentityAndSubmit(password).catch(function (err) {
      console.error('Key generation failed:', err);
      submitBtn.disabled = false;
      submitBtn.textContent = submitBtnDefaultText;
      showToast(MSG['auth.error.crypto.required']);
    });
  });

  async function generateIdentityAndSubmit(password) {
    var keyPair = await OE_CRYPTO.generateKeyPair();
    var publicKeyB64 = await OE_CRYPTO.exportPublicKey(keyPair.publicKey);
    document.getElementById('fldPublicKey').value = publicKeyB64;

    // standalone never encrypts content (e2eEncryption design doc §1), so nothing ever unwraps
    // this account's private key or recovery code for real work - only the public key above is
    // genuinely needed (approving a pending standalone member still wraps the workspace key for
    // it, users.pebble). Skip the PBKDF2/recovery-code generation and the "save your recovery
    // code" modal, which would have nothing meaningful to protect, and submit immediately.
    if (!window.OE_WORKSPACE_MODE) {
      document.getElementById('fldWrappedPrivateKey').value = 'standalone';
      document.getElementById('fldWrappedPrivateKeyRecovery').value = 'standalone';
      document.getElementById('fldRecoveryVerifier').value = 'standalone';
      submitBtn.textContent = MSG['auth.creating.account'];
      form.submit();
      return;
    }

    var salt = OE_CRYPTO.randomBytes(16);
    var passwordKek = await OE_CRYPTO.deriveKeyFromPassword(password, salt);
    var passwordWrap = await OE_CRYPTO.wrapPrivateKey(keyPair.privateKey, passwordKek);
    var wrappedPrivateKeyRecord = {
      salt: OE_CRYPTO.bufToBase64(salt), iv: passwordWrap.iv, wrapped: passwordWrap.wrapped
    };

    var recoveryBytes = OE_CRYPTO.generateRecoveryKeyBytes();
    var recoveryKek = await OE_CRYPTO.importRecoveryKeyAsAesGcm(recoveryBytes);
    var recoveryWrap = await OE_CRYPTO.wrapPrivateKey(keyPair.privateKey, recoveryKek);
    var wrappedPrivateKeyRecoveryRecord = { iv: recoveryWrap.iv, wrapped: recoveryWrap.wrapped };
    var recoveryVerifier = await OE_CRYPTO.deriveRecoveryVerifier(recoveryBytes);
    pendingRecoveryCode = OE_CRYPTO.formatRecoveryDisplayCode(recoveryBytes);

    document.getElementById('fldWrappedPrivateKey').value = JSON.stringify(wrappedPrivateKeyRecord);
    document.getElementById('fldWrappedPrivateKeyRecovery').value = JSON.stringify(wrappedPrivateKeyRecoveryRecord);
    document.getElementById('fldRecoveryVerifier').value = recoveryVerifier;

    var founderField = document.getElementById('fldFounderWrappedWsKey');
    if (founderField) {
      // Founding a new workspace (cloudGroupService design doc §2.3/§2.7's "새 워크스페이스
      // 만들기") - the workspace key is created right here and wrapped for the founder's own
      // public key, so a workspace never exists without one (e2eEncryption design doc §4).
      var wsKey = await OE_CRYPTO.generateWorkspaceKey();
      founderField.value = await OE_CRYPTO.wrapWorkspaceKeyForUser(wsKey, keyPair.publicKey);
    }

    document.getElementById('recoveryCodeValue').value = pendingRecoveryCode;
    submitBtn.textContent = submitBtnDefaultText;
    recoveryModal.show();
  }

  OE_RECOVERY_CODE_MODAL.bind({
    codeInputId: 'recoveryCodeValue', copyBtnId: 'btnCopyRecoveryCode', downloadBtnId: 'btnDownloadRecoveryCode',
    getCode: function () { return pendingRecoveryCode; }
  });

  document.getElementById('btnRecoveryCodeContinue').addEventListener('click', function () {
    recoveryModal.hide();
    submitBtn.disabled = true;
    submitBtn.textContent = MSG['auth.creating.account'];
    form.submit();
  });
})();
</script>
</body>
</html>
