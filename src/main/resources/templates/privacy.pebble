<!DOCTYPE html>
<html lang="{{ currentLocale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ msg['privacy.title'] }}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/brand.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/icon.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="bg-light">
<div class="d-flex min-vh-100 auth-wrap">
  <div class="container py-2">
    <div class="row justify-content-center">
      <div class="col-12 auth-col">

        <div class="text-center mb-3">
          <a href="/" class="text-decoration-none">
            <img src="/icon/oe_logo_original.svg" alt="oeHub Logo" class="oe-brand-logo">
            <h1 class="oe-brand-title">oeHub</h1>
          </a>
        </div>

        <div class="card shadow-sm">
          <div class="card-body p-4 privacy-policy">
            <h2 class="h5 text-center mb-4">{{ msg['privacy.title'] }}</h2>

            <p>{{ msg['privacy.intro'] }}</p>

            <h3>1. {{ msg['privacy.section.collected'] }}</h3>
            <ul>
              <li>{{ msg['privacy.collected.account'] }}</li>
              <li>{{ msg['privacy.collected.crypto'] }}</li>
              <li>{{ msg['privacy.collected.other'] }}</li>
              <li>{{ msg['privacy.collected.purpose'] }}</li>
            </ul>

            <h3>2. {{ msg['privacy.section.notcollected'] }}</h3>
            <ul>
              <li>{{ msg['privacy.notcollected.identity'] }}</li>
            </ul>

            <h3>3. {{ msg['privacy.section.retention'] }}</h3>
            <ul>
              <li>{{ msg['privacy.retention.delete'] }}</li>
              <li>{{ msg['privacy.retention.exception'] }}</li>
              <li>{{ msg['privacy.retention.logs'] }}</li>
              <li>{{ msg['privacy.retention.backups'] }}</li>
            </ul>

            <h3>4. {{ msg['privacy.section.rights'] }}</h3>
            <ul>
              <li>{{ msg['privacy.rights.body'] }}</li>
            </ul>

            <h3>5. {{ msg['privacy.section.third'] }}</h3>
            <ul>
              <li>{{ msg['privacy.third.none'] }}</li>
              <li>{{ msg['privacy.third.cookies'] }}</li>
            </ul>

            <h3>6. {{ msg['privacy.section.children'] }}</h3>
            <ul>
              <li>{{ msg['privacy.children.body'] }}</li>
            </ul>

            <h3>7. {{ msg['privacy.section.contact'] }}</h3>
            <ul>
              <li>{{ msg['privacy.contact.officer'] }} (<a href="mailto:tricatch@naver.com">tricatch@naver.com</a>)</li>
            </ul>

            <p class="text-muted mb-0">{{ msg['privacy.effective'] }}</p>
          </div>
        </div>

        <div class="text-center text-muted mt-3 small">
          <a href="/register">{{ msg['privacy.back.register'] }}</a> &middot; <a href="/login">{{ msg['privacy.back.login'] }}</a>
        </div>

      </div>
    </div>
  </div>
</div>
</body>
</html>
