*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif;
  background: #f4fbe8;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  color: #2d3748;
}

.card {
  background: #fff;
  border-radius: 14px;
  border: 1px solid #d8edbe;
  box-shadow: 0 6px 32px rgba(100, 170, 40, 0.10);
  padding: 2.5rem 2.75rem;
  max-width: 540px;
  width: 100%;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  margin-bottom: 2rem;
}

.brand-name {
  font-size: 0.92rem;
  font-weight: 700;
  color: #3a7a1e;
  letter-spacing: 0.03em;
}

.status-code {
  font-size: 4.5rem;
  font-weight: 800;
  color: #e53e3e;
  line-height: 1;
  letter-spacing: -0.02em;
}

.status-label {
  font-size: 1.3rem;
  font-weight: 600;
  color: #2d3748;
  margin-top: 0.25rem;
}

.status-desc {
  margin-top: 0.4rem;
  color: #718096;
  font-size: 0.82rem;
}

.divider {
  height: 1px;
  background: #edf7e0;
  margin: 1.5rem 0 1.25rem;
}

.section-label {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #5a9a30;
  margin-bottom: 0.55rem;
}

.section-label + .section-label,
.detail-table + .section-label,
.page-note + .section-label {
  margin-top: 1.25rem;
}

.detail-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.82rem;
}

.detail-table tr {
  border-bottom: 1px solid #f0f7e8;
}

.detail-table tr:last-child {
  border-bottom: none;
}

.detail-table th {
  text-align: left;
  padding: 0.45rem 0.7rem;
  font-weight: 600;
  color: #4a7a1e;
  background: #f8fdf2;
  width: 38%;
  font-size: 0.78rem;
}

.detail-table td {
  padding: 0.45rem 0.7rem;
  color: #4a5568;
  font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
  font-size: 0.8rem;
  word-break: break-all;
}

.page-note {
  font-size: 0.8rem;
  color: #4a5568;
  line-height: 1.65;
}

.detail-table + .page-note {
  margin-top: 0.75rem;
}

.page-note strong {
  color: #3a7a1e;
}

.error-msg {
  margin-top: 1rem;
  padding: 0.6rem 0.85rem;
  background: #fff5f5;
  border: 1px solid #fed7d7;
  border-left: 3px solid #fc8181;
  border-radius: 0 6px 6px 0;
  color: #c53030;
  font-size: 0.8rem;
  font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
  word-break: break-all;
}
